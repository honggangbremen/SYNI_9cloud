MODULE SYNI_OVERLAP
implicit none
logical,save:: BTinit = .false.

 TYPE  SYNI_OVERLAP_TYPE 
  sequence
  real cfi(0:4)		!INPUT::! Clr+ 4 Space viewed Cloud Fractions 
  real ptop(4)		!INPUT::! 4 Cloud Top Pressures
  real pbot(4)		!INPUT::! 4 Cloud Bottom Pressures
  real tau(4,2)         !INPUT::!4 spacview tau ( Log,Lin)  
  
  real Fcnd(0:15)	!Output ! Clr + 15 cloud overlapp fractions
  integer IPcnd(0:4)	 !Output ! Index to 15 cases of Clear + 4 most probable overlap cases
  logical BT(0:15,4)     !Output ! T/F matrix of cloud layer existence 
  integer novl(15)       !Output ! # of overlap layers in condition
  real oprf(15,4,2)	!Output ! Cloud Optical partitioning to overlap layers ( Log ,Lin)
  integer it(15)          !Output Top(1-4) for overlap case 
  integer isp(4)
  real thr ! Method 3 Tau Threshold
  real tmp(0:15)
  integer nnz
 end TYPE SYNI_OVERLAP_TYPE 

type (SYNI_OVERLAP_TYPE) so 


 CONTAINS
!====================================================================================
subroutine overlap_four_syni
real*8 c1,c2,c3,c4 ,one,sum1,sum2
integer i,j ,k,nnz ,itop
real stau(2)
real tau_below
integer nnz1,nnz2,nnz3,nnz4
real ss(4) 
logical ifirst(4)
!----------------------------------------------------------------------------------
if ( .not. BTinit ) then
!Overlap Cases T=CLD  F=nocld
 do j=1,4
 do i=1,15
 so%BT(I,J)=.not. btest(i-1,4-j)
 !print*,i,j,so%BT(i,J)
 enddo
 so%BT(0,J)=.not. btest(15,4-j)
 enddo
 BTinit=.true.
! so%thr =0.0001
! so%thr =1.4 ! Method 3 Tau Threshold pre 20130927
  so%thr =6.0 ! Method 3 Tau Threshold  20130927
! so%thr =512 ! This should turn off Cloud Overlap (20140618)

endif


!------------------------------------------------------------------------------------
! No-OVERLAP: HG-2025.07.17
!
  c1 = dble(so%cfi(1))
  one = 1.0d0

  if (sum(so%cfi(1:4)) == 0.00) then
    ! CLEAR SKY CASE
    so%Fcnd(0) = 1.0
    so%Fcnd(1:15) = 0.0
    so%IPcnd(0) = 0
    so%IPcnd(1:4) = -1  ! comment out, no effect, keep for safety
    so%nnz = 0
    so%BT = .false.
    so%oprf = 0.0
    so%novl = 0
    so%it = 0
  else
    ! NO-OVERLAP: only clear and single-cloud cases

    ! Limit cloud fractions to < 1.0
    where (so%cfi(1:4) >= 1.0) so%cfi(1:4) = 0.99999
    if (sum(so%cfi(1:4)) >= 1.00) so%cfi(1:4) = 0.99999 * so%cfi(1:4) / sum(so%cfi(1:4))

    ! Initialize outputs
    so%Fcnd = 0.0
    so%BT = .false.
    so%oprf = 0.0
    so%novl = 0
    so%it = 0
    so%IPcnd = -1   ! comment out, no effect, keep for safety
    so%nnz = 4

    ! Clear sky (case 0)
    so%Fcnd(0) = 1.0 - sum(so%cfi(1:4))
    so%IPcnd(0) = 0

    ! Single cloud cases (cases 1 to 4)
    do i = 1, 4
      so%Fcnd(i) = so%cfi(i)
      so%BT(i, :) = .false.
      so%BT(i, i) = .true.
      so%novl(i) = 1
      so%it(i) = i
      so%oprf(i, i, 1:2) = so%tau(i, 1:2)
      so%IPcnd(i) = i
    end do

    ! All other cases remain zero/false

  end if


end subroutine overlap_four_syni
