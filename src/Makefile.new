OBJS_F = 

TKLIBS = -L$(PGSLIB) -lPGSTK
CLIBS = $(CERESLIB)/data_products_Ed4.a $(CERESLIB)/cereslib_Ed4.a \
        /homedir/bhbranch/source_code/Fortran/netcdf_json_standalone/ceres_lut_io_static_lib.a \
        /SPG_ops/utils/CERES/TOOLKIT/scf_toolkit5.2.20v1-x86_64/lib/libjsonfortran.a
	
MOD_FLAG = -I. -I$(CERESLIB)/mod4 -I ../lib/fulib -I ../lib -I/homedir/bhbranch/source_code/Fortran/netcdf_json_standalone/mod
LIBS = ../lib/fulib/CER7.2.1P2_FuLib_x86_64.a ../lib/CER7.2.1P2_x86_64.a
INC_FLAG = -I$(NETCDFINC) -I$(PGSINC) -I$(HDFINC) -I$(HDF5INC) -I../include -I./include
INCLUDE_DIRS = -I/SPG_ops/utils/CERES/TOOLKIT/scf_toolkit5.2.20v1-x86_64/include \
                   -I$(CERESLIB)/include -I/homedir/bhbranch/source_code/Fortran/netcdf_json_standalone/
VPATH = .:$(NETCDFINC):$(PGSINC):$(HDFINC):$(HDF5INC):../include:./include

HDF_FLAGS = $(NETCDFDIR) $(HDFEOSDIR) $(HDFEOSLIB) $(HDFDIR) $(HDFLIBS) 
HDF5_FLAGS = $(HDFEOS5DIR) $(HDFEOS5LIB) $(HDF5DIR) $(HDF5LIBS) 
DAAC_FLAGS = $(ADD_LFLAGS) $(ADD_LIBS) 

#CC = 
#CFLAGS = 
#F90 = 
#F90COMP = 
F90COMP = -c -O2 -finit-local-zero -fno-second-underscore -fconvert=big-endian
#F90COMP = -c -g -O0 -fcheck=all -fbacktrace -finit-local-zero -fno-second-underscore -fconvert=big-endian
#FCOMP = 
#F90LOAD = 

all: $(PROG)

$(PROG): $(OBJS) $(OBJS_F) $(LIBS) $(CLIBS) 
	$(F90) $(F90LOAD) -o $@ $(OBJS) $(OBJS_F) $(NETCDFDIR) $(NETCDFLIBS) $(LIBS) $(CLIBS) \
	$(TKLIBS) $(HDF_FLAGS) $(HDF5_FLAGS) $(DAAC_FLAGS) 

clean:
	-\rm -f $(PROG) $(OBJS) $(OBJS_F) 
	-\rm -f *.mod 

.SUFFIXES: 

.SUFFIXES: .f90 .mod .f .c .o

.f90.o:
	$(F90) $(F90COMP) $(MOD_FLAG) $(INC_FLAG) $< 

.f90.mod:
	$(F90) $(F90COMP) $(MOD_FLAG) $(INC_FLAG) $< 

.f.o:
	$(F90) $(FCOMP) $(MOD_FLAG) $(INC_FLAG) $< 

.c.o:
	$(CC) $(CFLAGS) $(MOD_FLAG) $(INC_FLAG) $< 

