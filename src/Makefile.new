	SYN_SAHA.f90 SYN_SfcAlb_Init.f90 SYN_SG_Utils.f90 SYN_SPECTRAL_18.f90 \
	Syn_Spectral_Dat_18.f90 SynSARB_Ingest.f90 SynSARB_Meta.f90 \
	SynSARB_MOA_Utils.f90 TestReadSYNI.f90 TestReadSYNI2.f90 tlu.f90 \
	tlu_9clouds.f90 tsi_flag_ed4.f90 tsi_type_3x3_mod.f90 \
	tsi_type_mod.f90 Tune_Code.f90 TuneDrive.f90 UpTropHum.f90 \
	With_Cloud.f90 Wrap_Up_SS7_2.f90 write_test.f90

OBJS = alblib_data.o Ancill_Init.o aotfit.o ASSALUT_Sfcalb.o CHLOR_CLIM.o \
	common_access.o Control_Mod.o Convert_OptDepth.o CRH_Drv.o CRH_SARB.o \
