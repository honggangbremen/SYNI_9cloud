      SUBROUTINE Get_SolConst 
!
!*****************************************************************************
!
! !F90
!
! !Name:
!   Open_TSI
!
! !Description:
!    Routine ID - 7.2.1.5
!
!    Purpose - Opens the solar const file and reads in parameters
!
! !Input Parameters:
!    NONE 
!
! !Output Parameters:
!    NONE 
!
! !Team-Unique Header:
!
!  Modules Used: (Parameters followed by "*" are defined by this routine)
!
! !Revision History:
!  Version 1.1   June 4, 2014 - SCCR #1017
!                Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!                 Added variable solar constant provided by TISA group 
!  Version 1.0  February 6, 2014 - SCCR #nn  
!               Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!               Initial version of code
!
! !END
!
!*****************************************************************************
!
!
     INTEGER :: I, IOS, IYear, IMonth, IDay
     INTEGER :: fyear, fmonth, fday, dateflag
     CHARACTER (LEN= 28) :: header
!
!
! *** Open Solar constant file
!
     CALL OpenFile (LogicID = LID_SolConst, status = IOS,	 & ! I
     		    handle = IUnit_SolConst,		  	 & ! I
     		    mode = "R", access ="S",		         & ! I
     		    format = "F")			           ! I

     Solar_Constant = Default_REAL4_FL
     
     IYear = 2000
     IMonth = 1
     
     dateflag = 0
     
     READ (IUnit_SolConst, 100) header
     
     DO WHILE (dateflag == 0)
      NumDays_Mon = DaysPerMonth(IMonth, IYear)
      
      DO IDay = 1, NumDays_Mon 
       READ (IUnit_SolConst, 101) fyear, fmonth, fday, Solar_Constant(IYear, IMonth, IDay)
       IF (IYear == fyear .AND. IMonth == fmonth .AND. IDay == fday) THEN
        continue
       ELSE
        print*,'error reading solar constant file ',IYear, IMonth, IDay
	stop 
       ENDIF
      ENDDO
      
      IF (IYear == DataYear .AND. IMonth == DataMonth) dateflag = 1
      
      IF (IMonth == 12) THEN 
       IYear = IYear + 1
       IMonth = 1
      ELSE
       IMonth = Imonth + 1
      ENDIF
            
     ENDDO
!
     CALL CloseFile (file_handle = IUnit_SolConst, status = IOS)
!
 100 FORMAT (a28)
 101 FORMAT (4x,i4,2x,i2,2x,i2,2x,f10.5)
!
     END SUBROUTINE Get_SolConst
