      CALL SARB_GenOpen (LID_TSI, Flag_File_Read, Flag_File_Direct,  & ! I
                         Flag_File_Unformat, Name_Sbr,               & ! I
                                                       IUnit_TSI,    & ! O
                         RLength = RecLen_TSI)                         ! I (Opt)  
