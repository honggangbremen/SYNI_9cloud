      SUBROUTINE Start7_2 (fqc)                                         ! O
!
!*****************************************************************************
!
! !F90
!
! !Name:
!   Start7_2
!
! !Description:
!    Routine ID - 7.2.1
!
!    Purpose - Initializes subsystem processing.
!              
!
! !Input Parameters:
!    NONE
!
! !Output Parameters:
!    fqc - Array of QC report variables
!
! !Team-Unique Header:
!
!  Internal Routines Used:
!    EarthSun_Var_Calc
!    Open_SYN
!    Open_TSI 
!
!  Modules Used: (Parameters followed by "*" are defined by this routine)
!    Ancill_Init       - (SARBlib)  Sbr. AerClim_OpenDrive, Open_MOA
!    DrivIngest        - (SARBlib)  Sbr. Deriv_Init
!    FL_IO_Params      - (SARBlib)  Params: Default_REAL4_FL, Inst_Idx*
!    QC_Init           - (SARBlib)  Sbr. QCSARB_Init
!    SARB_Init_Utils   - (SARBlib)  Sbr. Define_WidthWN, InstrIdx_Define
!    SARB_IO_Utils     - (SARBlib)  Sbr. RunTimeVar_DateRetrieve, 
!                                        RunTimeVar_SatRetrieve
!    SARB_Var          - (SARBlib)  Params: AerClimSrc_Flag*, CMonth*, CYear*,
!                                           DataMonth*, DataYear*, IHour*
!    SYN_SfcAlb_Init   - (InstSARB) Sbr. SfcAlb_IO_Drv 
!    SigmaIngest       - (SARBlib)  Sbr. Sigma_Init
!    SynSARB_IO_Params - (SynSARB)  Params: LID_Collins, LID_DrivTab, 
!                                           LID_GFDLAer, LID_Instrument,  
!                                           LID_Month, LID_SigTab, 
!                                           LID_Year, Unit_Aer*
!
! !Revision History:
!  Version 5.0   May 27, 2020 - SCCR #1657
!                Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!                Added changes for Entropy, pristine, and tune flags
!  Version 3.4  June 20, 2003 - SCCR #445  
!               Lisa Coleman, SAIC, l.h.coleman@larc.nasa.gov
!               Initial version of code
!
! !END
!
!*****************************************************************************
!
!
      TYPE (fqc_type), INTENT (OUT) :: fqc
!
      INTEGER  :: status 
      CHARACTER (LEN=3) :: Instr_Name
      CHARACTER (LEN=80) :: PStrat
      CHARACTER (LEN=7) :: Ent_char, Pris_char, Tune_char
!
      FLAG_OP = CERSYN
!
! *** Retrieve job parameters identifying current data set
!
      CALL RunTimeVar_DateRetrieve (LID_Mn=LID_Month,               & ! I (Opt)
                                    LID_Yr=LID_Year,                & ! I (Opt)
                                    IMn=DataMonth,                  & ! O (Opt)
                                    IYr=DataYear,                   & ! O (Opt)
                                    CMn=CMonth, CYr=CYear)            ! O (Opt)
! 
      CHour = '01'
      CDay = '01'
      CALL RunTimeVar_SatRetrieve (LID_Inst=LID_Instrument, LID_Sat=LID_Satellite,  & ! I (Opt)
                                  CInst=Instr_Name,CSat=Sat_Name)   ! O (Opt)
!
      CALL InstrIdx_Define (Instr_Name,                             & ! I
                                        Instr_Idx)                    ! O
!
!
! *** Call GetParam to determine if in Subset mode
!  
      CALL GetParam (143, PStrat, status)
      IF (PStrat (2:7) == 'Subset') THEN
!     *** Only Process those FOVs coinciding with a CERES Validation Region
          ValOut_Flag = ValOut_ON
      ELSE
!     *** Process all FOVs provided on input
          ValOut_Flag = ValOut_OFF
      END IF

! *** Retrieve processing parameters
!  
      CALL GetParam (604, Ent_char, status)
      IF (Ent_char (2:6) == 'false' .OR. Ent_char (2:6) == 'FALSE') THEN
!     *** Process using entropy code
          Entropy = .FALSE.
      ELSE
          Entropy = .TRUE.
      END IF

      CALL GetParam (605, Pris_char, status)
      IF (Pris_char (2:6) == 'false' .OR. Pris_char (2:6) == 'FALSE') THEN
!     *** Process using pristine code
          Pristine = .FALSE.
      ELSE
          Pristine = .TRUE.
      END IF

      CALL GetParam (606, Tune_char, status)
      IF (Tune_char (2:6) == 'false' .OR. Tune_char (2:6) == 'FALSE') THEN
!     *** Process using tuning code
          Tuning = .FALSE.
      ELSE
          Tuning = .TRUE.
      END IF
!  
! *** Open control file and read data source rules 
!
      CALL Control_Init (LID_RuleFile)
!
!
! *** Open ancillary input data files necessary for constrainment process
      CALL Deriv_Init (LID_DrivTab)                                      ! I
      CALL Sigma_Init (LID_SigTab)                                       ! I
!
!
! *** Open solar constant file and read values
!
      CALL Get_SolConst 
!
! *** Open input file for the current zone
!
      CALL Open_TSI 
!
!
! *** Define window channel width and flux range values
!
      CALL Define_WidthWN (Instr_Idx,                                  & ! I
                           WN_Width, WNflx_Low, WNflx_High)              ! O
!
!
! *** Initialize surface albedo history map 
!
      CALL SfcAlb_IO_Drv
! 
!
! *** Determine availability of aerosol climatologies
!      CALL AerClim_OpenDrive (LID_Collins, LID_AerCollinsBackup, DataMonth, & ! I
!                                           AerClimSrc_Flag, IUnit_Aer)        ! O
!
!
! *** Open Hour 0 MOA file and retrieve required parameters from the header
!
      IHour = 0
      CALL Open_MOA (LID_MOA)
!
!
! *** Initialize QC report parameters
! 
      CALL QCSARB_Init (Default_REAL4_FL,                               & ! I
                                          fqc)                              ! O

! *** Open output file
      CALL Open_SYN
!
!
      END SUBROUTINE Start7_2
