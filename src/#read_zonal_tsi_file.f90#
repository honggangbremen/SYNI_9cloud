         tsi_rec%clrsky_area_data%aero_vis_opdep063

    WRITE(*,*) 'aero_vis_opdep160 = ', &
         tsi_rec%clrsky_area_data%aero_vis_opdep160

    WRITE(*,*) 'ir_radiance       = ', &
         tsi_rec%clrsky_area_data%ir_radiance

    WRITE(*,*) 'imager_rad4       = ', &
         tsi_rec%clrsky_area_data%imager_rad4

    !-------------------------------------------------
    ! FLUXES
    !-------------------------------------------------
    WRITE(*,*) '--- Fluxes_tsi ---'

    WRITE(*,*) 'data_flg      = ', tsi_rec%fluxestsi%data_flg
    WRITE(*,*) 'total_sw_mn   = ', tsi_rec%fluxestsi%total_sw_mn
    WRITE(*,*) 'total_lw_mn   = ', tsi_rec%fluxestsi%total_lw_mn
    WRITE(*,*) 'total_alb_mn  = ', tsi_rec%fluxestsi%total_alb_mn
    WRITE(*,*) 'total_wn_mn   = ', tsi_rec%fluxestsi%total_wn_mn
