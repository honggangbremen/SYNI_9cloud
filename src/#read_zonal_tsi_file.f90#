    WRITE(*,*) 'clear_lw_mn   = ', tsi_rec%fluxestsi%clear_lw_mn
    WRITE(*,*) 'clear_alb_mn  = ', tsi_rec%fluxestsi%clear_alb_mn
    WRITE(*,*) 'clear_wn_mn   = ', tsi_rec%fluxestsi%clear_wn_mn

    !-------------------------------------------------
    ! CLOUD LAYERS
    !-------------------------------------------------
    WRITE(*,*) '--- Cloud Layers ---'

    DO i = 1, 9

       WRITE(*,*)
       WRITE(*,*) 'Cloud Layer = ', i

       WRITE(*,*) 'areafrac_total = ', &
            tsi_rec%cld_layer(i)%areafrac_total

       WRITE(*,*) 'optdepth_mn_lnr = ', &
            tsi_rec%cld_layer(i)%optdepth_mn_lnr

       WRITE(*,*) 'optdepth_mn_log = ', &
            tsi_rec%cld_layer(i)%optdepth_mn_log

       WRITE(*,*) 'emiss_ir_mn = ', &
            tsi_rec%cld_layer(i)%emiss_ir_mn

       WRITE(*,*) 'h2opath_mn = ', &
            tsi_rec%cld_layer(i)%h2opath_mn

       WRITE(*,*) 'icepath_mn = ', &
            tsi_rec%cld_layer(i)%icepath_mn

       WRITE(*,*) 'toppres_mn = ', &
            tsi_rec%cld_layer(i)%toppres_mn

