       WRITE(*,*) 'surf_perc_cov(',i,') = ', &
            tsi_rec%timeandloc%surf_perc_cov(i)
    END DO

    !-------------------------------------------------
    ! CLEAR SKY AREA
    !-------------------------------------------------
    WRITE(*,*) '--- clr_sky_area_data ---'

