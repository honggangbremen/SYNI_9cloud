    !-------------------------------------------------
    WRITE(*,*) '--- Time_and_location_data ---'

    WRITE(*,*) 'region_num        = ', tsi_rec%timeandloc%region_num
    WRITE(*,*) 'hour_box_num      = ', tsi_rec%timeandloc%hour_box_num
    WRITE(*,*) 'geo_sat_id        = ', tsi_rec%timeandloc%geo_sat_id
