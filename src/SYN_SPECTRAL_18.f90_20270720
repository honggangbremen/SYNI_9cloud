real function sahwhensnowice(ilon,ilat)
USE CRHSARB ,only : igbp, create_contents
USE SAHPERT ,only : SAHPERT_TYPE ,apply_sahpert
type (SAHPERT_TYPE) sap

integer ilon,ilat,i,j,k, ktot,ki
integer*1 content(36),igbpgz(6,360,6)
REAL content_vector(36,2)
REAL ,dimension(18) :: wgts,speca
REAL :: frac, foce 
REAL:: bbatemp




igbpgz =  reshape( igbp ,(/6,360,6/) )
 k=0
do i=1,6
do j=1,6
k=k+1
 content(k) = igbpgz(i,ilon,j)
! print'(4i6)',ilon,i,j,k,content(k)
enddo;enddo
! Find the Untouched IGBP Types and Percent coverages over current 1x1deg box
 call create_contents(content,content_vector,ktot)
 
 
 sap%salb000 = 0.0
 sap%salb100 = 0.0
 foce=0.0 
 do ki=1,ktot
  k    = content_vector(ki,1)
  frac = content_vector(ki,2)*0.01
  if ( frac < 0.0 .or. frac > 1.0001 ) cycle 

!  CALL syn_land_spec (k, u0diffuse, sg%pw, speca(1:15))  
!  CALL syn_swdn_wgts (u0diffuse, sg%pw, k, wgts) 
!  sap%salb000= sap%salb000 + SUM (wgts( 1:15) *  speca(1:15) ) * frac  
  
   call syn_land_spec18 (k, u0diffuse, sg%pw, 2.0,  speca(1:18), bbatemp) !Diffuse
   sap%salb000= sap%salb000 + bbatemp * frac  
  
  if ( k == 17 )              foce =foce +frac
 enddo

!   k=19   !! Mostly Land
!   if ( foce > (100.-land_th)*0.01 ) k = 20 !! Mostly Ocean

  k = 15 ! permanent snow ( larger grain slightly darker)
 
!  CALL syn_land_spec (k, u0diffuse, sg%pw, speca(1:15))  
!  CALL syn_swdn_wgts (u0diffuse, sg%pw, k, wgts) 
!  sap%salb100 = SUM (wgts( 1:15) *  speca(1:15) )

  call syn_land_spec18 (k, u0diffuse, sg%pw, 2.0,  speca(1:18), bbatemp) !Diffuse
  sap%salb100=  bbatemp * frac  
  


 sap%salbXSAH     = adiff1x1(ilon,ilat)   !!! SAH Monthly Mean albedo 
 sap%cry_fracXSAH = snoice1x1(ilon,ilat)  !!! SAH Monthly Mean SnowIce Fraction
 sap%mu0 = mu0_1x1(ilon,ilat)
! print*,'sap%mu0 ', sap%mu0
 
! sap%salb000	     !!! Assumed surface albedo for 0 fraction SNOWorICE
! sap%salb100        !!! Assumed surface albedo for 1.0 fraction  SNOWorICE
 sap%cry_frac     =  cry_area*0.01 !!! SNOWorICE fraction
  
 call apply_sahpert(sap)
  
!print'(a7,I5,20(2f7.2,2x))','RAWIGBP',ilon,(content_vector(k,1:2),k=1,ktot), sap%salb000,sap%salb100,cry_area
!print'(a7,I5,4ES12.4,3x,2f8.3)','SAHWHEN',ilon, sap%salb000,sap%salbXSAH,sap%salb100 ,sap%cry_fracXSAH, sap%cry_frac, sap%salbSAHCRY

!sahwhensnowice = sap%salbSAHCRY !!! at mu0

		 
sahwhensnowice	= SAH_diurnal_model_apply(sap)		 
			 
			 		 
end function sahwhensnowice
!=============================================================================================================== 
! New for Ed4
real function SAH_diurnal_model_apply(sap)

USE Syn_Spectral_Dat_18 , only : d3,dickensonx,wangx
USE SAHPERT ,only : SAHPERT_TYPE ,apply_sahpert

  USE COMMON_ACCESS , only : HrBox   !HG-20260716


type (SAHPERT_TYPE) sap			 
real :: aaa0,aaa1
real sahx
integer kk


kk = maxval(maxloc(sg%ptv)) ! Predominate IGBP type

print *, ' '
print *, 'HG-20260428'
print *, ', kk, sg%spec_source_flag, msa%ngood, msa%istatus: ', kk, sg%spec_source_flag, msa%ngood, msa%istatus
print *, ' '

if( sg%spec_source_flag == 0 .and. msa%ngood > 0 .and. msa%istatus == 0) then  !! MCD43C1 Source

 msa%aot = sg%aertau
 msa%sza = acos(sap%mu0)*180./3.14159
 call get_msa

 !print *, 'HG-20260320, test3'
 !print'(3f8.2,10f8.4,f6.0,I7,2f8.4)',msa%rlatC, msa%rlonW, msa%rlonE ,msa%modalb(1:10),float(msa%istatus),msa%ngood,msa%sza,msa%aot

 !stop
 
 aaa0 = msa%modalb(10)
!

 msa%aot = sg%aertau
 msa%sza = acos(sg%u0)*180./3.14159
 call get_msa

 !!HG-20260320
 !print *, 'HG-20260320, test5'
 !print'(3f8.2,10f8.4,f6.0,I7,2f8.4)',msa%rlatC, msa%rlonW, msa%rlonE ,msa%modalb(1:10),float(msa%istatus),msa%ngood,msa%sza,msa%aot

 aaa1 = msa%modalb(10)


 sahx = sap%salbSAHCRY *  (aaa1/aaa0 )! At sza1 ie at clear SZA for hr-box Acording to MCD43C1 diurnal model

!HG-20260423
 print  *, 'HG checking aaa0, aaa1'
 print *, 'msa%rlonW, msa%rlonE, sap%salbSAHCRY, sap%mu0,sg%u0,aaa0,aaa1,sahx, kk, ptv(kk),msa%ngood, msa%istatus, HrBox'
 print *, msa%rlonW, msa%rlonE, sap%salbSAHCRY, sap%mu0,sg%u0,aaa0,aaa1,sahx, kk, sg%ptv(kk),msa%ngood, msa%istatus, HrBox
 !print *, msa%rlonW, msa%rlonE

 print *, 'aaa1/aaa0=, ', aaa1/aaa0
 print *, ' '
 print *, 'testing dickensonx(sap%salbSAHCRY,0.4,sap%mu0,sg%u0)'
 print *, 'sahx= ', dickensonx(sap%salbSAHCRY,0.4,sap%mu0,sg%u0)
 print *, '(1.0+2.0*0.4*sap%mu0) / (1.0+2.0*0.4*sg%u0) '
 print *, (1.0+2.0*0.4*sap%mu0) / (1.0+2.0*0.4*sg%u0) 
 print *, ' '
 
elseif(  sg%spec_source_flag == 1 .or. &  !!! A Zjin LUT source
       sg%spec_source_flag == 3 .or. & 
       sg%spec_source_flag == 4 .or. &
       sg%spec_source_flag == 5 .or. & 
       sg%spec_source_flag == 6   ) then ! Jin_Luts
       

    jlut%u0  = sap%mu0
    jlut%tau = sg%aertau
    CALL jin_all_luts !! Snow Spectral Albedo
    aaa0 = colorme_to_broadband( kk ,sg%pw,jlut%u0,log(jlut%tau), jlut%specalb(1:18)) !! SAH Mean u0
 
    jlut%u0  = sg%u0
    jlut%tau = sg%aertau
    CALL jin_all_luts !! Snow Spectral Albedo
    aaa1 = colorme_to_broadband( kk ,sg%pw,jlut%u0,log(jlut%tau), jlut%specalb(1:18)) !!Actual u0


    sahx = sap%salbSAHCRY *  (aaa1/aaa0 )! At  sg%u0 ie at clear SZA for hr-box Acording to ZJIN diurnal model

 !   print*, 'SAH / zjin for model',sap%salbSAHCRY, sap%mu0,sg%u0,aaa0,aaa1,sahx

else ! Default or possibly bad MCD43C1

 aaa0 = -1.0
 aaa1 = -1.0
 
!! Move SAH to actual sun angel using simple Dickenson or Wang diurnal models  
  if ( kk > 12 .or. kk == 11 ) then 
   sahx = dickensonx(sap%salbSAHCRY,d3(0,kk),sap%mu0,sg%u0) !!! TO DIFFUSE ALBEDO
  else 
   sahx = wangx(sap%salbSAHCRY, kk, sap%mu0,sg%u0)!!! TO DIFFUSE ALBEDO
  endif

endif	! Three types of spectral albedo sources


!  print*, 'SAH_diurnal_model',sg%spec_source_flag,sap%salbSAHCRY, sap%mu0,sg%u0,aaa0,aaa1,sahx


SAH_diurnal_model_apply = sahx

end function SAH_diurnal_model_apply
