SUBROUTINE get_bb_sfcalb(ilon,ilat)
!
! !Revision History:
!  Version 4.0   August 18, 2006 - SCCR #634  
!                Thomas Caldwell, SAIC, t.e.caldwell@larc.nasa.gov
!                Changed:
!                sg%bba_untuned = omit
!                To:
!                sg%bba_untuned = sg%bbainit_grid(1)
!           

  !HG-put to test
USE COMMON_ACCESS , only : HrBox, RegionNum_CERES
  
INTEGER ilon,ilat
REAL spec1,cldlntau,totcldfrac
REAL albuse
!real albratio(2,0:maxcld)

REAL alb_nonocean
REAL :: ctau_wm(maxcld) ,ctau1_wm
!
REAL, DIMENSION(18) :: specalb_g1b,wgts ,prsrat
REAL, DIMENSION(18,2,maxcld) :: spec_diurnal_clrtocld
INTEGER  ksid,iaer,icld
REAL :: BBNORMRATIO

!HG
integer :: ilon_m, dom
integer :: iiilat, iiilon, ihlat, ihlon
real    :: rrrlat, rrrlon, rlat, rlon, rhlat, rhlon



!print*, 'sg%src_swclr',sg%src_swclr


 ctau_wm = 0.0

isclear = .FALSE.
IF (sg%toa_clr >0 .AND. sg%toa_clr < 1.0 .and. sg%clearfrac > 1.0 - 1.0E-6 ) isclear = .TRUE. !!! CLEAR SKY TOA BBALB IS PRESENT  !HG-20250910
!IF (sg%toa_clr >0 .AND. sg%toa_clr < 1.0 .and. sg%clearfrac > 0.10 ) isclear = .TRUE. !!! CLEAR SKY TOA BBALB IS PRESENT

ishisun = .FALSE.
IF ( sg%u0 > 0.3 )  ishisun = .TRUE.

istotal = .FALSE.
IF (sg%toa_tot >0 .AND. sg%toa_tot < 1.0 ) istotal = .TRUE.  !!! TOTAL SKY TOA BBALB IS PRESENT

! if Percent of the EXTENDED SYN scene vector is greater than  snowy_th % Is SNOWY
snowy =  .FALSE.
icey  =  .FALSE.
 ice_area  = sg%ptv(20)
 snow_area = sg%ptv(15)+sg%ptv(19) +sg%ptv(21)+sg%ptv(22)

!print'(a10,4f8.1,f8.1)','SNOW',sg%ptv(15),sg%ptv(19),sg%ptv(21),sg%ptv(22),snow_area
 cry_area = snow_area +ice_area
 IF( ( snow_area)  > snowy_th ) snowy = .TRUE.
 IF( (  ice_area)  >  icey_th ) icey = .TRUE.
land = .FALSE.
IF( (100. - sg%p17) >  land_th  ) land = .TRUE.   !!! IF (NOT NATIVE OCEAN) THEN LAND or SNOW or ICE

IF ( land .AND. (snowy .OR. icey ) ) land = .FALSE.  !IF (SNOWY OR ICEY) Then NOT LAND

OCEAN = .FALSE.
if ( sg%ptv(17) >= ocean_th  ) ocean = .TRUE.  !! HERE USE DYNAMIC OCEAN ( it's tricky)
!print*, sg%ptv(17),ocean


where ( sg%cldfrac > 0 .and. sg%cldfrac <= 1.0 .and.&
        sg%cldtau >= 0 .and. sg%cldtau < 1000.) &
         ctau_wm = exp(sg%cldfrac*log(sg%cldtau) ) ! Cloud Fraction weighted mean Cloud TauS
 
    ctau1_wm = sum ( ctau_wm ) ! Cloud Fraction weighted mean Cloud Tau
!    print*,'ctau_wm',ctau_wm, ctau1_wm 

sg%bba_source_flag = 0  !!! First assume default albedo
sg%bba_untuned = sg%bbainit_grid(1)  ! Bring in 'default' cookiecut BBSfcAlb
! HG-20250918 need to check sg%bba_untuned

sg%bbalut_clr = omit
sg%bbalut_sno = omit
sg%bbalut_sah = omit


!!!!
sg%bbalut_sah = sahwhensnowice(ilon,ilat) ! CALL SAH Perturbed by Microwave Snow& Ice
!!!!!
!print *, 'RAW SAH: ilon ilat adiff1x1 snoice1x1 mu0_1x1 =', &
!         ilon, ilat, adiff1x1(ilon,ilat), snoice1x1(ilon,ilat), mu0_1x1(ilon,ilat)
!print *, 'SAH USED (after pert+diurnal): bbalu_sah =', sg%bbalut_sah



!---Keep or Adjust Albedo to BroadBand retrieval or history value.
! The IF-Elseif structure forms a heirarchy be carfull with the order
!HG-20250915, only keep 0--ocean and 3--SAH
!sg%bba_source_flag = -9999
!HG-20260303, condition only for daytime

!print*, 'sg%u0, istotal, ocean, land, snowy, icey, sg%bbalut_sah'
!print*, sg%u0, istotal, ocean, land, snowy, icey, sg%bbalut_sah

!if (ilon >= 150 .and. ilon <= 186) then
!   print*, 'Sarah Desert, ilon, sg%bba_source_flag, sg%spec_source_flag, ptv17'
!   print*, ilon, sg%bba_source_flag, sg%spec_source_flag, sg%PTV(17)
!   print*, ' '   
!end if
!dom = maxloc(sg%ptv(1:24), dim=1)

! Treat "Sahara Desert" as: not ocean, and dominant scene is class 12

!if (ilat == 66 .and. dom == 16 .and. sg%ptv(17) < 1.0) then
!if (ilat == 66 ) then
!  print*, 'HrBox, RegionNum_CERES', HrBox, RegionNum_CERES
!  print*, 'Test conversion, ilat_test, ilon_test, rlat, rlon'
!  print*, (RegionNum_CERES-1)/360+1, mod(RegionNum_CERES-1,360)+1, &
!       89.5-real((RegionNum_CERES-1)/360), 179.5-real(mod(RegionNum_CERES-1,360))
!  if ((179.5-real(mod(RegionNum_CERES-1,360)))> -15.0 .and. (179.5-real(mod(RegionNum_CERES-1,360)))<30.0) then
!     print*, 'Sahara Desert (by scene): ilat,ilon=', ilat, ilon
!     print*, 'Fred coversion, ilat, ilon, rlat, rlon:'
!     iiilat = (RegionNum_CERES-1)/360 + 1
!     iiilon = mod(RegionNum_CERES-1,360) + 1 
!     rrrlat = 89.5 - real(iiilat-1)
!     rrrlon = real(iiilon-1) - 179.5
!     if (rrrlon < 0.0) rrrlon = rrrlon + 360.0
!     print*, iiilat, iiilon, rrrlat, rrrlon
!     print*, 'ptv(16), ', sg%PTV(16)
!  endif
!  
!end if


!if (ilat == 66 ) then
!  print*, 'HrBox, RegionNum_CERES', HrBox, RegionNum_CERES
!  print*, 'Test conversion, ilat_test, ilon_test, rlat_test, rlon_test'
!
!  iiilat = (RegionNum_CERES-1)/360 + 1
!  iiilon = mod(RegionNum_CERES-1,360) + 1 
!  rrrlat = 89.5 - real(iiilat-1)
!  rrrlon = real(iiilon-1) - 179.5
!  if (rrrlon < 0.0) rrrlon = rrrlon + 360.0 
!  print*, iiilat, iiilon, rrrlat, rrrlon
!
!  print*, ' '
!!  if (rrrlon > -15.0 .and. rrrlon < 30.0) then
!  call deg1_latlon(ilat, ilon, rlat, rlon)
!  if (rlon >= 345.0 .or. rlon < 30.0) then

!  !HG-20260402 this is right one -20260423 
  !    if (msa%rlonW >=-14.0 .and. msa%rlonW < 29.0) then

!  !HG-20260428, Canada, 95W to 60W lat=60N
!    if (msa%rlonW >=-95.0 .and. msa%rlonW <= -60.0) then

  !HG-20260429, Amazon, 80W to 40W lat=5S, ilat=95
!    if (msa%rlonW >=-80.0 .and. msa%rlonW <= -40.0) then

! Greenland, 50W to 40W 
!    if (msa%rlonW >=-50.0 .and. msa%rlonW <= -40.0) then

! HG-20260717, Amazon, 65W to 55W
!    if (msa%rlonW >=-65.0 .and. msa%rlonW <= -55.0) then

! HG-20260719, Africa, 25E to 35E
    if (msa%rlonW >=25.0 .and. msa%rlonW <= 35.0) then


  print*, 'Africa, (25E-35E), (by scene, syni): ilat,ilon,rlat,rlon='

!  print*, 'Amazon, (65W-55W), (by scene, syni): ilat,ilon,rlat,rlon='
!  print*, 'Greenland, (50W-40W), (by scene, syni): ilat,ilon,rlat,rlon='

  !  print*, 'ilat,ilon,rlat,rlon from deg1_latlon which is from 0.5 to 359.5='
!  print*, 'rlat,rlon from deg1_latlon, (0-180) keeps, (-180-0) + 360'
!  
!     print*, ilat, ilon, rlat, rlon
     print*, 'ptv(kk), msa%ngood, ', sg%PTV, msa%ngood
     print*, 'msa%rlonW, msa%rlonE: ', msa%rlonW, msa%rlonE
!
!
print*, 'Before assignment:', 'ilon, ilat, sg%bba_source_flag, sg%spec_source_flag'
print*, 'Before assignment:', ilon, ilat, sg%bba_source_flag, sg%spec_source_flag

IF ( ocean ) then  ! It' really ocean ( dynamicly varing scene id) ! DEFAULT:OCEAN is Z.Jin BB Sfcalb

 sg%bba_source_flag = 0
 sg%bba_untuned     = sg%bbainit_ocean(1)
 !sg%bba_untuned     = sg%bbainit_grid(1) !HG-20250916

!ELSEIF( flsa_on .AND. &
!    ( (land .OR. snowy .OR. icey) .AND. &
!       isclear .AND. &
!       ishisun .AND. &
!       sg%spec_source_flag <5 )) THEN !! TOA LUT if CLEAR TOA ALB IS PRESENT! !---Clear Sky FLSA LUT
!	
!  spec1= log(	  sg%sfc_spectral_alb(  11, 1, 0) ) / &
!    	 log( sum(sg%sfc_spectral_alb(8:10, 1, 0)/3.0 ) ) !ln(nir/vis) 
!
!  sg%bbalut_clr= flsa0404_lut(sg%toa_clr,sg%u0,sg%pw,sg%o3,sg%aertau,spec1,sg%psfc,sg%wssa)
!
!!!! IF Portion of NonOceans Albedo is within range use the TOA based Retrieval.
!
!  alb_nonocean = -9999.
!  IF ( sg%ptv(17) /= 100 .AND. sg%ptv(17) >= 0 ) &
!   alb_nonocean = (  sg%bbalut_clr  -   &
!   sg%ptv(17)*0.01* sg%bbainit_ocean(1)  ) / &
!   ( 1.0 - sg%ptv(17)*0.01 )
!!    PRINT'(a20,3f8.3)','test_nonocean',sg%ptv(17),sg%bbainit_nonocean(1),alb_nonocean
!  
!  IF ( (  land .AND. (alb_nonocean > 0 .AND. alb_nonocean < 0.50 ) ) .OR. &
!  ( (snowy .OR. icey) .AND. (alb_nonocean > 0 .AND. alb_nonocean < 1.00 ) ) ) THEN
!    sg%bba_untuned = sg%bbalut_clr
!    sg%bba_source_flag = 1 ! Clear Sky Snow LUT Retrieval (FLSA)
!  ENDIF 
!
!
!ELSEIF( assalut_on .AND. &
!    ( snowy .AND. &
!      istotal .AND. & 
!      ishisun .AND. &
!      sg%p17 < ocean_th .AND. &
!      ctau1_wm < 20 .AND. &
!      sg%spec_source_flag <5)) THEN  !------ASSALUT Cloudy Sky Snow LUT
! 
!!  sg%bbalut_sno  = flsasnow_lut(sg%toa_tot,sg%u0,cldlntau,totcldfrac) ! Used IN Beta3 SYNI
!   
!!ASSALUT Inputs Beta4 (May8 2007) 
!assalut%cfra(1:maxcld) = sg%cldfrac(1:maxcld)  ! Cloud Fraction (0-1)
!assalut%chgt(1:maxcld) = sg%chgt(1:maxcld)  ! Cloud Top Height (m) (0- 14000)
!assalut%cpz(1:maxcld)  = sg%cpz(1:maxcld) ! Cloud Particle size( 5-30 water) (30-180 ice)
!assalut%ctau(1:maxcld) = sg%cldtau(1:maxcld) ! Cloud Tau ( 0-128)
!assalut%elev    =  8000.* log(1013.25/sg%psfc)      ! Sfc Elevation (m) (0 -8000)
!assalut%o3	= sg%o3        ! Ozone DU ( 200 -500)
!assalut%pw	= sg%pw        ! Precipitable water (cm) (0-7)
!assalut%u0	= sg%u0        ! CosSol (0-1)
!assalut%toa     = sg%toa_tot   ! TOA ALBEDO (0-1)
! 
!  call avg_cloud_condition (assalut)
!   
!  call assalut_lut (assalut, sg%bbalut_sno) 
!  
!  sg%bba_untuned = sg%bbalut_sno
!  sg%bba_source_flag = 2  !! Cloudy Sky Snow LUT Retrieval (ASSALUT)
!
!!print*,'ASSALUT1',sg%bbalut_sno, sg%toa_tot
!!print*,'ASSALUT2',assalut%cfra
!!print*,'ASSALUT3',assalut%chgt
!!print*,'ASSALUT4',assalut%cpz
!!print*,'ASSALUT5',assalut%ctau
!!print*,'ASSALUT6',assalut%elev,assalut%o3, assalut%pw,assalut%u0
!
!
!ELSEIF (sg%spec_source_flag <5 ) then !!Daily Snow/ice Perturbed Surface Albedo History Map Clear Sky Moved by to Specalb implicit diurnal model 
!! Intended for Clear or Cloudy (Land and SeaIce )

 ELSE
 sg%bba_untuned  = sg%bbalut_sah  !!! Clear-sky SAH perturbed  at mu0 
 sg%bba_source_flag = 3  !!! Clear-sky SAH perturbed at moved from mu0 to sg%u0 

!ELSEIF (sg%spec_source_flag ==5 ) then
! sg%bba_source_flag = 5  ! SGR RETRIEVAL
!ELSEIF (sg%spec_source_flag ==6 ) then
! sg%bba_source_flag = 6  ! OLD SGR RETRIEVAL diurnal model spectral shape
!ELSE
ENDIF  !..............................................

!!HG-20260303
!!print*, 'After assignment:', sg%bba_source_flag
print*, 'After assignment:', 'ilon, ilat, sg%bba_source_flag, sg%spec_source_flag, sg%bbalut_sah'
print*, 'After assignment:', ilon, ilat, sg%bba_source_flag, sg%spec_source_flag, sg%bbalut_sah
print*, ' '
!
!

! Sahara, HG
  endif
  
!end if



! HG-20250917

!!------------------------------------------------------------------
!IF ( sg%bba_source_flag < 0 .or. sg%bba_source_flag > 6 .or. &
!     sg%bba_untuned < 0.01 .or. sg%bba_untuned > 0.99 ) then 
! ! DEFAULT: No source of BB surface albedo use existing Scene type  based Clear Sky Value
! sg%bba_source_flag = sg%bba_source_flag*10 
! sg%bba_untuned     = sg%bbainit_grid(1)
!ENDIF  

!------------------------------------------------------------------
!print'(a20,i3,6L1,f8.3)', 'sg%bba_source_flag=',sg%bba_source_flag,isclear,ocean,land,snowy,icey,ishisun,sg%bba_untuned


! Apply Retrieved BROADBAND SFC ALBEDO to Spectral SfcAlb for Multiple Sky conditions 
! Some needing a diurnal model application
! print*,sg%bba_untuned,sg%bbainit_grid(1:2)

!Find and keep 'diurnal model' for clear to cloudysky to apply later to normalized clear sky
 
! print'(a8,2I4,18f7.3)', 'ClrUnA',1,0,sg%sfc_spectral_alb(1:18,  1, 0 )
 
 CldCond: do icld   = 1,maxcld !!! FOR CONDITIONS WITH CLOUD ONLY Move to Diffuse Angle
  if ( sg%cldfrac(icld) == 0.0 ) cycle 
   AerCond: do iaer =1,2 ! 1=WithAot  2=NOAOT
   spec_diurnal_clrtocld(1:18,iaer ,icld) = 1.00

   where( sg%sfc_spectral_alb(1:18, iaer, 0 ) .ne. 0 ) &
   spec_diurnal_clrtocld(1:18,iaer,icld) = sg%sfc_spectral_alb(1:18,iaer,icld) / sg%sfc_spectral_alb(1:18,iaer,0)
  
!   print'(a8,2I4,18f7.3)', 'CldUnA',iaer,icld,sg%sfc_spectral_alb(1:18,  iaer, icld )
!   print'(a4,18f7.3)', 'RAT',spec_diurnal_clrtocld(1:18,iaer,icld)

  enddo AerCond
 enddo CldCond


prsrat(1:18) = sg%sfc_spectral_alb(1:18, 2, 0 )/ sg%sfc_spectral_alb(1:18, 1, 0 ) 
!print*,'PRSRAT',prsrat


! ADJUST CLEAR-SKY and PRISTINE-SKY SPECTRAL ALBEDO!
IF ( sg%bba_untuned >= 0 .AND. sg%bba_untuned <= 1.0 .AND.  &
        (sg%bba_source_flag == 1  &
    .OR. sg%bba_source_flag == 2  &
    .OR. sg%bba_source_flag == 3 ) ) then

      !print *, "300 DEBUG: sg%bba_source_flag (sg%bba_untuned) =", sg%bba_untuned !HG-20250918


    BBNORMRATIO = sg%bba_untuned /sg%sfc_broadband_alb(1,0) !***********

!    print*,'BBNORMRATIO',BBNORMRATIO

    sg%sfc_spectral_alb(1:18, 1, 0 )  =  &
    sg%sfc_spectral_alb(1:18, 1, 0 ) *  BBNORMRATIO !! Normalize CLEAR-SKY  W/Aerosol

    sg%sfc_spectral_alb(1:18, 2, 0 )  =  &
    sg%sfc_spectral_alb(1:18, 1, 0 ) * prsrat(1:18)   !! Normalize Pristne-Sky based on Clear-Sky
    
    WHERE ( sg%sfc_spectral_alb(1:18, 1:2, 0 ) > 1.0 ) sg%sfc_spectral_alb(1:18, 1:2, 0 ) = 1.0
    WHERE ( sg%sfc_spectral_alb(1:18, 1:2, 0 ) < 0.0 ) sg%sfc_spectral_alb(1:18, 1:2, 0 ) = 0.0
    

!albratio(1:2) = sg%bba_untuned / sg%bbainit_grid(1:2)
!IF ( sg%bba_untuned< 0 .OR. sg%bba_untuned >1.0  &
!.OR. sg%bba_source_flag == 0  &
!.OR. sg%bba_source_flag == 5  &
!.OR. sg%bba_source_flag == 6 ) albratio(1:2) = 1.0
!Simple Ratio adjustment to BROADBAND SFC ALBEDO for Clear and Pristine 
!For ALL Cloud Conditions (treat cloudy sky conditions wiht clear retrieval in later step) 
!sg%sfc_spectral_alb(1:18, 1, : )  =  &
!sg%sfc_spectral_alb(1:18, 1, : ) * albratio ( 1 )  !! Clear W/Aerosol
!sg%sfc_spectral_alb(1:18, 2, : )  =  &
!sg%sfc_spectral_alb(1:18, 2, : ) * albratio ( 2 )  !! Pristine
!---------

! Cloudy Sky SfcAlb Diurnal Model to Specalbedo ( Not for DEfault or SGR retrievals or ASSALUT)
!!!!IF ( sg%bba_source_flag == 1 .or. sg%bba_source_flag == 3 ) then !------>>>> Move Clear Sky REtrievals for Cloudy sky conditions
!  print*,'sg%sfc_spectral_alb(1:15) clr then cloudcond'
!  print'(a8,2i4,18f6.3)', 'ClrAdj',1,0,sg%sfc_spectral_alb(1:18,  1, 0 )

    CldCond2: do icld   = 1,maxcld !!! FOR CONDITIONS WITH CLOUD ONLY Move Clear / Pristine  to Cloudy Diffuse Angle
      if ( sg%cldfrac(icld) == 0.0 ) cycle 
      AerCond2: do iaer =1,2 ! 1=WithAot  2=NOAOT
      sg%sfc_spectral_alb(1:18, iaer, icld)  =  &
      sg%sfc_spectral_alb(1:18, iaer, 0 ) *  spec_diurnal_clrtocld(1:18,iaer,icld) !Move according to Diurnal Model
!      print'(a8,2i4,18f6.3)', 'CldAdj',iaer,icld,sg%sfc_spectral_alb(1:18,  iaer, icld )
      enddo AerCond2
    enddo CldCond2

endif ! Only Normalize albedo for a broadband clear sky retrieval!------<<<<


WHERE ( sg%sfc_spectral_alb > 1.0 ) sg%sfc_spectral_alb = 1.0
WHERE ( sg%sfc_spectral_alb < 0.0 ) sg%sfc_spectral_alb = 0.0
!
!print'(a25,5f8.3)','BB SALB_CLR_SNO_SAH',sg%bbalut_clr,sg%bbalut_sno,sg%bbalut_sah

! if (sg%spec_source_flag == 3  )stop 'get_bb_sfcalb'

! HG-20250917
!print *, "DEBUG: sg%bba_source_flag (after assign) =", sg%bba_source_flag

!! HG-20250925
!if (sg%bba_source_flag > 1000) then
!print *, "DEBUG 600: sg%bba_source_flag  =", sg%bba_source_flag
!endif

END SUBROUTINE get_bb_sfcalb

!================================================================
!
SUBROUTINE deg1_latlon(ilat,ilon, rlat,rlon)

INTEGER ilat,ilon
REAL rlat,rlon
rlat = 89.5 - (ilat-1)  
rlon = (ilon-1) + 0.5
if ( rlon < 0 ) rlon =rlon +360.
END SUBROUTINE deg1_latlon
!
!================================================================
!
END MODULE SYNSPECTRAL

