MODULE TSI_TYPE_MOD
  !***************************************************************
  !!F90
  !  Name: TSI_TYPE_MOD
  !
  !!Description:
  ! Routine ID:
  ! Purpose:   This module contains TSI record structure and related read,
  !            write, open, close, with ToolKit routines. And also contains
  !            declarations to write tsi secondary index file, and routines
  !            to open, close, read, write secondary index file, routine to
  !            write whole month worth of records of a nested grid region.
  !            The record of TSI holds  Time and location
  !            data,Fluxes, Cloud category property data, Column
  !            averaged cloud properties, overlap data for cloud
  !            overlap conditions and Angular model scene class data,
  !            surface data.
  !
  !!Input parameter
  !!Output parameter
  !
  !
  !!Team-Unique Header
  !  Public routines
  !         TSI_init, TSI_open, TSI_close,TSI_read,TSI_print
  !
  ! Comments:
  !!Revision History:
  ! Version 2.2 May 2004
  !           A 4-digit integer flag represents the data type for the TOA SW and 
  !           LW fluxes is added in the Fluxes_tsi type structure.
  !           There are 4 parts in the flag, from left to right: 
  !             - clear-sky LW flux 
  !             - clear-sky SW flux
  !             - total-sky LW flux
  !             - total-sky SW flux
  !
  !           The meaning of the flag:                            
  !           =  1  : CERES data         
  !           =  2  : GGEO data (can be default if there is no CERES observation
  !                                     in the day)
  !           =  3  : interpolated data
  !           =  0  : default
  !
  ! Version 2.1 November 1997
  !           The  Aerosol visible optical depth, Aerosol Effective radius
  !           have been changed to Aerosol visible optical depth063 and
  !           Aerosol visible optical depth160 in clear sky area data.
  !
  ! Version 2.0  March 1997
  !           Updated Type definitions,TSI_init, and TSI_print &
  !           routines according to R2 specifications.
  !           Surface Land area types(10) and sea area types(3)
  !           has been replaced by Surface Type(20)
  !           Precipitable water has been deleted from location category.
  !           Cosine Solar Zenith Angle has been added to location category.
  !           Aerosol visible optical depth, Aerosol Effective radius,
  !           Aerosol percent cover, Snow/Ice cover, Smoke cover, Fire cover,
  !           Sun glint percent parameters have been added to clear sky area data.
  !           Broken cloud area fraction, Overcast cloud area percentage
  !           parameters have been deleted from cloud layers and cloud weighted
  !           properties category.
  !           Incident Solar Flux is a single element instead of an array in
  !           Angular model scene category.
  !           Deleted Photosynthetically active radiation and Direct/Diffuse
  !           ratio from surface only data.
  !           Added Spectral Albedo(6), Broadband surface albedo,
  !           LW surface emissivity, WN emissivity, Imager-based skin
  !           temperature, Corrected initial broadband surface albedo to
  !           surface data.
  !
  !  Revision 2.1  2004/05/14
  !  Le Trang C. Nguyen, le.t.nguyen@larc.nasa.gov
  ! 
  !  SCCR  # N/A (Initial Version)
  !  Version 1.0  JULY 17, 1995
  !  Rajalakshmy Raju, r.raju@larc.nasa.gov
  !  Initial Implementation
  !!end
  !*******************************************************************
  USE ceres_defaults, ONLY : int4_dflt,int2_dflt,REAL4_DFLT
  USE ceres_indices,  ONLY : num_landtyp,num_seatyp,opt_bins
  USE ceres_status,   ONLY : OK, BAD,DIRECT_FILE,DA_EOF,EOF
  USE ceres_time,      ONLY : HOURS_IN_DAY,MAX_DAYS_IN_MONTH
  USE f90_kind,       ONLY : int2,int4,real4,real8
  USE MSG,            ONLY : WriteReport,WriteStatus
  USE IO,             ONLY : OpenFile, CloseFile

  IMPLICIT NONE
  INCLUDE "PGS_TSI_25910.f"
  INCLUDE "PGS_SMF.f"
  INCLUDE "PGS_CERES_25000.f"
  PRIVATE
  PUBLIC  ::    Time_and_location_data,    Fluxes_tsi,    &
            &   clr_sky_area_data,         Cld_cat,       &
            &   Overlap_data,              Surface_data,  &
            &   TSI_TYPE,                  aerosol_data,  &
            &   TSI_init,  TSI_open,      &
            &   TSI_close,                 TSI_read,      &
            &   TSI_print,                                &
            &   num_surftyp, num_overlap,cld_layrs

  INTEGER, PARAMETER           :: num_surftyp      = 20
  INTEGER,PARAMETER            :: cld_layrs        = 9  !4, HG-20250731
  INTEGER,PARAMETER            :: num_overlap      = 11
  !* declarations for tsi secodary index
  INTEGER, PARAMETER           :: TSI_ZONE_LOGIC_ID = 401
  INTEGER, PARAMETER           :: REGIONS_PER_FILE =360
  LOGICAL, SAVE                :: closed_flag = .TRUE.,init_flag = .TRUE.


  !* TSI ARRAY RECORD STRUCTURE

  !* REGION AREA, TIME, LOCATION DATA
  TYPE Time_and_location_data
     SEQUENCE
     INTEGER (int4)             ::      region_num                   !4,TSI
     INTEGER (int4)             ::      hour_box_num                 !5,TSI
     INTEGER (int4)             ::      geo_sat_id
     REAL (real4)               ::      julhr                        !3,TSI
     REAL (real4)               ::      sfc_alt                      !6 TSI
     REAL(real4)                ::      cos_sol_zenith               !7 TSI
     REAL(real4)                ::      surf_perc_cov(num_surftyp)  !8-27 TSI
     REAL(real4)                ::      view_angle            ! from GGEO
     REAL(real4)                ::      imager_view_angle      !from FSW
  END TYPE Time_and_location_data

  !* CLEAR SKY AREA DATA
  TYPE clr_sky_area_data
     SEQUENCE
     REAL(real4)                ::      aero_vis_opdep063           !31 TSI
     REAL(real4)                ::      aero_vis_opdep160           !31a
  !--- add new params
     REAL(real4)                ::      ir_radiance
     REAL(real4)                ::      imager_rad4
  END TYPE clr_sky_area_data

  !* TOA FLUXES
  TYPE Fluxes_tsi
     SEQUENCE
     INTEGER(int4)              ::      data_flg
     REAL (real4)               ::      total_sw_mn                  !34 TSI
     REAL (real4)               ::      total_lw_mn                  !36 TSI
     REAL (real4)               ::      total_alb_mn                 !38 TSI
     REAL (real4)               ::      total_wn_mn                  !40 TSI
     REAL (real4)               ::      clear_sw_mn                  !42 TSI
     REAL (real4)               ::      clear_lw_mn                  !44 TSI
     REAL (real4)               ::      clear_alb_mn                 !46 TSI
     REAL (real4)               ::      clear_wn_mn                  !48 TSI

  END TYPE Fluxes_tsi

  !* CLOUD INFORMATION
  TYPE Cld_cat
     SEQUENCE
     REAL (real4)               ::      areafrac_total          !54  167 TSI
     REAL (real4)               ::      optdepth_mn_lnr         !58  172 TSI
     REAL (real4)               ::      optdepth_mn_log
     REAL (real4)               ::      emiss_ir_mn             !66  182 TSI
     REAL (real4)               ::      h2opath_mn              !74  192 TSI
     REAL (real4)               ::      icepath_mn              !82  202 TSI
     REAL (real4)               ::      toppres_mn              !90  212 TSI
     REAL (real4)               ::      effpres_mn              !98  222 TSI
     REAL (real4)               ::      efftemp_mn              !106 232 TSI
     REAL (real4)               ::      effht_mn                !114 242 TSI
     REAL (real4)               ::      botpres_mn              !122 252 TSI
     REAL (real4)               ::      radius_h2o_mn           !130 262 TSI
     REAL (real4)               ::      radius_ice_mn           !138 272 TSI
     REAL (real4)               ::      phase_mn                !146 282 TSI
!    REAL (real4)               ::      asp_ratio_mn            !154 292 TSI
     REAL (real4)               ::      toptemp_mn
     REAL (real4)               ::      bottemp_mn
     REAL (real4)               ::      top_height
     REAL (real4)               ::      bot_height
  END TYPE Cld_cat


  !* OVERLAP DATA FOR 11 CLOUD CONDITIONS
  TYPE Overlap_data
     SEQUENCE
     REAL (real4)           :: areafrac_ov(num_overlap)             !302 TSI
  END TYPE Overlap_data

  !* SURFACE DATA
  TYPE Surface_data
     SEQUENCE
     INTEGER(int4)          ::      skintemp_flg                !381 TSI
     REAL(real4)            ::      lw_surf_emiss               !381 TSI
     REAL(real4)            ::      wn_surf_emiss               !382 TSI
     REAL(real4)            ::      sfc_skin_temp               !383 TSI
     REAL(real4)            ::      moa_skin_temp               !383 TSI
  END TYPE Surface_data


  !** AEROSOL TYPE
  TYPE aerosol_data
     SEQUENCE
     REAL(real4)    ::  init_aero_optdep
     REAL(real4)    ::  aero_const_ratio(7)
     REAL(real4)    ::  optdepth047_land
     REAL(real4)    ::  optdepth055_land
     REAL(real4)    ::  optdepth066_land
     REAL(real4)    ::  optdepth047_ocean
     REAL(real4)    ::  optdepth055_ocean
     REAL(real4)    ::  optdepth066_ocean
     REAL(real4)    ::  optdepth087_ocean
     REAL(real4)    ::  optdepth124_ocean
     REAL(real4)    ::  optdepth164_ocean
     REAL(real4)    ::  optdepth213_ocean
  END TYPE aerosol_data

  !***                          TSI RECORD                         ***
  TYPE TSI_TYPE
     SEQUENCE
     TYPE (Time_and_location_data)       timeandloc
     TYPE (clr_sky_area_data)            clrsky_area_data
     TYPE (Cld_cat)                      cld_layer(cld_layrs)
     TYPE (Fluxes_tsi)                   fluxestsi
     TYPE (Overlap_data)                 overlap
     TYPE (Surface_data)                 surface
     TYPE (aerosol_data)                 aerosol
  END TYPE TSI_TYPE

CONTAINS

  SUBROUTINE TSI_init(TSI,begnum,endnum)
    !*******************************************************************
    !!F90
    ! Name:         TSI_init
    !
    !!Description:
    ! Routine ID :
    !
    ! Purpose: This subroutine initialize the TSI array elements.
    !
    !!Input Parameters :
    ! INTEGER             :: begnum, endnum
    !
    !!Output Parameters :
    !   TYPE(TSI_TYPE)     :: TSI
    !
    !!Team-Unique Header:
    !  Local Parameters
    !   INTEGER            : i - loop variable
    !
    !!Revision History:
    !     Revision 2.0 March 1997
    !     Modified routine according to type definition changes.
    !     Rajalakshmy Raju, r.raju@larc.nasa.gov
    !     Modified : October 1996
    ! SCCR  # N/A (Initial Version)
    ! Version 1.0  July 17, 1995
    ! Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! Initial Implementation
    !
    !!end
    !*******************************************************************
    IMPLICIT NONE
    TYPE(TSI_TYPE), INTENT(out) :: TSI(:)
    INTEGER, INTENT(in)         :: begnum, endnum
    !local variables
    INTEGER                     :: i, tsi_reclen
    INTEGER(int4)               :: intg = INT4_DFLT
    REAL(real4)                 :: rrl  = REAL4_DFLT

    INQUIRE(iolength=tsi_reclen) tsi(1)

    DO i = begnum,endnum
       TSI(i) % timeandloc = Time_and_location_data(intg,intg,intg, &
                            & rrl,rrl,rrl,rrl,rrl,rrl)
       TSI(i) % clrsky_area_data = clr_sky_area_data(rrl,rrl,rrl,rrl) 
       TSI(i) % fluxestsi  =  Fluxes_tsi(intg,rrl,rrl,rrl,rrl,rrl,rrl,rrl, &
                                       rrl)
       TSI(i) % cld_layer  =  Cld_cat(rrl,rrl,rrl,rrl,rrl,rrl,rrl, &
                                      rrl,rrl,rrl,rrl, rrl,rrl,rrl,rrl,rrl,rrl,rrl)
       TSI(i) % overlap   =  Overlap_data(rrl)
       TSI(i) % surface   =  Surface_data(intg,rrl,rrl,rrl,rrl)
       TSI(i) % aerosol   =  aerosol_data(rrl,rrl,rrl,rrl,rrl,rrl,rrl,rrl,rrl,rrl,rrl,rrl)
    END DO
  RETURN
  END SUBROUTINE TSI_init

