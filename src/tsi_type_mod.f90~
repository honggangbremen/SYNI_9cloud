             &   topheight(mean),botheight(mean)",   &
             &   /2x,F6.2,2(/20x,6F10.5), /20x,5F10.5)


       !* CLOUD OVERLAP_DATA
       WRITE(unitnum,700)(TSI(i) %overlap %areafrac_ov(k),k=1&
            & ,num_overlap)
