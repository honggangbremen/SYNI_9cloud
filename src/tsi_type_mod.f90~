    IMPLICIT NONE
    INTEGER,intent(out)   ::  tsi_reclen
    TYPE(TSI_TYPE)        :: TSI

    INQUIRE(iolength=tsi_reclen) tsi

    print *, 'tsi_reclen = ', tsi_reclen
!    CALL FLUSH(6)
!
!    stop
    
  END SUBROUTINE get_tsi_reclen

  SUBROUTINE TSI_open(LogicID,actmode,reclen,tsi_unit_no, open_success,version)
! SUBROUTINE TSI_open(LogicID,actmode,tsi_unit_no, open_success,version)
    !*******************************************************************
    !!F90
    !
    ! Name: TSI_open
    !
    !!Description:
    ! Routine ID :
    !
    ! Purpose: This routine opens only a Direct, Unformated tsi file to
    !          read or write. It returns unit number, and a status flag
    !          indicating success, or fail. Version number is optional.
    !          If version number is not present then it uses default value 1.
    !
    !!Input Parameters :
    !   INTEGER                  : LogicID - User supplied Logical ID.
    !   CHARACTER                : actmode    - Action Read/Write
    !   INTEGER                  : rec_len - TSI record length
    !   INTEGER(optional)        : vers - Version No.
    !
    ! Input/Output Parameters:
    !       none
    !
    !!Output Parameters :
    !   INTEGER                  : unitnum    - data file unit number
    !   INTEGER                  : open_success - Flag indicating  success
    !                                            or fail operation
    !!Team-Unique Header:
    ! Local variable:
    !   INTEGER                        : status - success or fail flag
    !
    ! External Files:
    ! Implementation/Unique Features:
    ! Optional Headings:
    !!Revision History:
    ! SCCR  # N/A (Initial Version)
    ! Version 1.0  July 17, 1995
    ! Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! Initial Implementation
    !
    !!end
    !*******************************************************************
    IMPLICIT NONE
    INTEGER,         INTENT(in)     :: LogicID           !PCF file number
    CHARACTER(LEN=*),INTENT(in)     :: actmode
    INTEGER,         INTENT(in)     :: reclen            !PCF file number
    INTEGER,         INTENT(out)    :: open_success, tsi_unit_no
    INTEGER, INTENT(in), OPTIONAL :: version
    !Local variable
    INTEGER      :: status, ios, length, tsi_version_no, reclen_test

TYPE(TSI_TYPE) :: TSI_rec

    !*** initialize values ***
    ios = 0
    status = OK

 !--- Cathy's test
    INQUIRE(iolength=reclen_test) TSI_rec
 ! end Cathy's test
    !*** determine record length for open statement
!   length = reclen
    length = reclen_test

    !*** Set the version number for the TSI file to open ***
    IF (PRESENT(version)) THEN
       tsi_version_no = version
    ELSE
       tsi_version_no = 1
    END IF

      CALL OpenFile(LogicID, status, tsi_unit_no,&
                &  mode = actmode,&
                & access = DIRECT_FILE, reclen=length, version=tsi_version_no)

      IF (status ==  OK) THEN
             open_success = OK
      ELSE
             CALL WriteReport(CERES_F_OPEN_ACCESS_ERROR,FuncName = "TSI_open ",  &
                 & StrVAr = "FATAL : Error occured while opening the file.")
             open_success = BAD
      END IF

  RETURN
  END SUBROUTINE TSI_open

  SUBROUTINE TSI_close(tsi_unit_no,close_success)
    !*******************************************************************
    !!F90
    ! Name:         TSI_close
    !
    !!Description:
    ! Routine ID :
    !
    ! Purpose: This routine closes a specified number of tsi files
    !          and sends back success(OK) or fail (BAD) flag to the
    !          calling routine.
    !
    !!Input Parameters :
    !   INTEGER    : unitnum  - data file unit number to close
    !   INTEGER    : num_of_files - number files to be closed.
    !
    ! Input/Output Parameters:
    !   none
    !
    !!Output Parameters :
    !   INTEGER   : close_success - success or failure flag.
    !
    !!Team-Unique Header:
    !  Local Variables :
    !   INTEGER   :   iostatus -  Flag indicating success or fail.
    ! Optional Headings:
    !
    !!Revision History:
    ! SCCR  # N/A (Initial Version)
    ! Version 1.0  July 17, 1995
    ! Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! Initial Implementation
    !
    !!end
    !********************************************************************
    IMPLICIT NONE
    INTEGER,         INTENT(in)             :: tsi_unit_no
    INTEGER,         INTENT(out)            :: close_success
    !LOCAL VARIABLES
    INTEGER                    :: iostatus,i

      CALL CloseFile(tsi_unit_no,iostatus)
      IF (iostatus == OK) THEN
           close_success = OK
      ELSE
         CALL WriteReport(TSI_E_CLOSE_ERROR,FuncName = "TSI_close ",  &
         & StrVar = "ERROR : Error while closing the file on unit ",&
         & IVar1 = tsi_unit_no )
         close_success = BAD
      END IF

  RETURN
  END SUBROUTINE TSI_close

  SUBROUTINE TSI_read(unitnum,tsi_rec_num,tsi_rec,read_success)
    !*********************************************************************
    !!F90
    ! Name:     TSI_read
    !
    !Description:
    ! Routine ID :
    !
    !Purpose:   The purpose of this routine is to read one TSI record
    !           from the tsi file.
    !
    !!Input Parameters :
    !   INTEGER    : unitnum  - data file unit number
    !   INTEGER    : tsi_rec_num  - starting number of records to read
    !
    !Input/Output Parameters:
    !
    !!Output Parameters :
    !   TYPE       :  tsi_rec  -  holds one tsi record data.
    !   INTEGER    :  read_success  - success or fail flag.
    !!Team-Unique Header:
    !
    !  Local Variables :
    !    INTEGER   :  ios - success or fail flag
    !    INTEGER   :  tsi_rec_num - loop variable.
    !
    !!Revision History:
    ! SCCR  # N/A (Initial Version)
    ! Version 1.0  July 17, 1995
    ! Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! Initial Implementation
    !
    ! External Files:
    !
    !!end
    !***********************************************************************
    IMPLICIT NONE
    INTEGER (int4),           INTENT(in)    :: unitnum
    INTEGER(int4),            INTENT(in)    :: tsi_rec_num
    TYPE(TSI_TYPE),           INTENT(out)   :: tsi_rec
    INTEGER,                  INTENT(out)   :: read_success
    ! LOCAL VARIABLES
    INTEGER                               :: ios

    READ(unitnum, REC = tsi_rec_num, iostat = ios) tsi_rec
    IF (ios == OK) THEN
       read_success = OK
    ELSE
       IF (ios == DA_EOF) THEN
           CALL WriteReport(TSI_E_EOF_ERROR,FuncName = "TSI_read ",  &
           & StrVAr = "RECORD NUMBER = ",IVar1 = tsi_rec_num)
          read_success = EOF
       ELSE
          CALL WriteReport(TSI_E_RDWRT_ACC_ERROR, funcName =&
          & "TSI_read ", StrVAr = "error occured while &
	  &  reading tsi file record number:  ",IVar1 = tsi_rec_num )
          read_success = BAD
       END IF
    END IF

  RETURN
  END SUBROUTINE TSI_read

  SUBROUTINE TSI_print(unitnum,TSI,beg_rec,end_rec)
    !*******************************************************************
    !!F90
    ! Name:         TSI_print
    !
    !!Description:
    !ROUTINE ID :
    !
    !!Purpose: This routine writes TSI records to the sequential
    !          formatted file.
    !
    !!Input Parameters :
    ! Integer   : unitnum - unit number
    ! TYPE(TSI_TYPE)    : TSI     -  Array with TSI records.
    ! INTEGER           : beg_rec - starting record number.
    ! INTEGER           : end_rec - Ending record number.
    !
    !!Output parameters :
    !
    !!Team-Unique Header:
    !  Local Variables:
    !    INTEGER       : k,i - loop variables
    !
    !!Revision History:
    !     Revision 2.0 March 1997
    !     Modified routine according to  the release 2
    !     type definition changes.
    !     Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! SCCR  # N/A (Initial Version)
    ! Version 1.0  July 17, 1995
    ! Rajalakshmy Raju, r.raju@larc.nasa.gov
    ! Initial Implementation
    !
    !!end
    !*****************************************************************
    IMPLICIT NONE
    INTEGER,             INTENT(in)    :: unitnum
    TYPE(TSI_TYPE),      INTENT(in)    :: TSI(:)
    INTEGER,             INTENT(in)    :: beg_rec,end_rec
    ! LOCAL VARIABLES
    INTEGER 		:: k,i

!   TIME AND LOCATION DATA
    DO i = beg_rec,end_rec
       WRITE(unitnum,10) i
       10  FORMAT("RECORD NUMBER : ",I7)
       WRITE(unitnum, 100)  &                       !TSI(i) %timeandloc %julday, &	
	 & TSI(i) %timeandloc %julhr,	            &		
	 & TSI(i) %timeandloc %region_num,          &		
	 & TSI(i) %timeandloc %hour_box_num,        &		
	 & TSI(i) %timeandloc %sfc_alt,             &
         & TSI(i) %timeandloc %cos_sol_zenith,      &
	 & (TSI(i) %timeandloc %surf_perc_cov(k), k = 1,num_surftyp)
       100 FORMAT("TIME AND LOCATION DATA : ", &
                 " julian day, julhr,hourbox,sfc_alt,cos_sol_zenith,&
                 & surf_perc_cover ",/20x,2F10.5,2I5,2F10.5,4(/20x,5F10.4))
        !clr_sky_area_data
        WRITE(unitnum,150) TSI(i)%clrsky_area_data%aero_vis_opdep063,&
                         & TSI(i)%clrsky_area_data%aero_vis_opdep160
!      150 FORMAT("Clear sky area data ","snow_ice_cov,&
!               &,aero_vis_opdep063,aero_vis_opdep160 &
!               &,aero_perc_cov, suglint_perc " ,/20x,5(F10.4))
       150 FORMAT("Clear sky area data ","&
                &,aero_vis_opdep063,aero_vis_opdep160 &
                &,suglint_perc " ,/20x,2(F10.4))

       !FLUXES
       WRITE(unitnum, 200) TSI(i) %fluxestsi %total_sw_mn ,&
            & TSI(i) %fluxestsi %total_lw_mn , &
            & TSI(i) %fluxestsi %total_alb_mn ,&
            & TSI(i) %fluxestsi %total_wn_mn, &
            & TSI(i) %fluxestsi %clear_sw_mn,&
            & TSI(i) %fluxestsi %clear_lw_mn,&
            & TSI(i) %fluxestsi %clear_wn_mn,&
            & TSI(i) %fluxestsi %clear_alb_mn
       200 FORMAT("FLUXES ","sw total(mean),lw total(mean),&
               & total alb(mean),total wn(mean),sw clear(mean&
                 &),lw clear(mean),clear alb(mean),clear wn(mean) ", (/20x,8F10.4))

       !CLOUD LAYER
       DO k = 1,cld_layrs
          WRITE(unitnum, 300) TSI(i) %cld_layer(k) %areafrac_total, &
                      & TSI(i) %cld_layer(k) %optdepth_mn_lnr, &
                      & TSI(i) %cld_layer(k) %optdepth_mn_log, &
                      & TSI(i) %cld_layer(k) %emiss_ir_mn, &	
                      & TSI(i) %cld_layer(k) %h2opath_mn, &	
                      & TSI(i) %cld_layer(k) %icepath_mn, &	
                      & TSI(i) %cld_layer(k) %toppres_mn, &
                      & TSI(i) %cld_layer(k) %effpres_mn, &	
                      & TSI(i) %cld_layer(k) %efftemp_mn, &	
                      & TSI(i) %cld_layer(k) %effht_mn, & 	
                      & TSI(i) %cld_layer(k) %botpres_mn, &	
                      & TSI(i) %cld_layer(k) %radius_h2o_mn, &
                      & TSI(i) %cld_layer(k) %radius_ice_mn, &
                      & TSI(i) %cld_layer(k) %phase_mn     , &	
                      & TSI(i) %cld_layer(k) %toptemp_mn, &
                      & TSI(i) %cld_layer(k) %bottemp_mn, &
                      & TSI(i) %cld_layer(k) %top_height, &
                      & TSI(i) %cld_layer(k) %bot_height
       END DO
       300 FORMAT("CLOUD LAYER  ",/"area_frac total &
             &    optdepth_lnr(mean),optdepth_log(mean),  &
             &    emiss_ir(mean),h2opath(mean),icepath(mean), &
