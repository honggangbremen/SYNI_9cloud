MODULE ED4_SYNI_STRUCTURE
!
!*****************************************************************************
!
! !F90
!
! !Name:
!   ED4_SYNI_STRUCTURE
!
! !Description:
!
!    Purpose - To declare data structures and TYPEs for Edition4 SYNI
!
!
! !Input PARAMETERs:
!   NONE
!
! !Output PARAMETERs:
!   NONE
!
! !Team-Unique Header:
!
!  Internal Routines:
!    pfp         - Packs flux data
!    ufp         - Unpacks flux data 
!    SYNI4_null  - Set SYNI Ed4 structure to defaults 
!    SYNI4_print - Diagnostic routine for printing SYNI4 values 
!
!  Modules Used:
!   
! !Revision History:
!  Version 1.0   October 1, 2013 - SCCR #1017
!                 Fred Rose, SSAI, Fred.G.Rose@nasa.gov
!                 Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!                 Initial Version of Module
!
! !END
!
!*****************************************************************************
!
!
      IMPLICIT NONE
!
      INTEGER,PARAMETER    :: nl=6  , nl2 = 2  ! ED4_SYNI
      INTEGER,PARAMETER    :: nswb =  4 , nlwb=5  !20140213

      REAL*8, PARAMETER    :: REAL8_DFLT = 1.7976931348623157D+308 ! HUGE(REAL8)

      REAL, PARAMETER      :: REAL4_DFLT = 3.4028235E+38           ! HUGE(REAL4)
      INTEGER , PARAMETER  :: INT4_DFLT = 2147483647 ! HUGE(int4) = (2**31)-1
      INTEGER*2, PARAMETER :: INT2_DFLT = 32767      ! HUGE(int2) = (2**15)-1
 
! Tuned FULL 6level Profile                    

      TYPE PRF_TYPE
        SEQUENCE
        INTEGER*2 d(2:nl)   !! DOWNWELLING 
        INTEGER*2 u(nl)     !! UPWELLNG
      END TYPE PRF_TYPE
             
! UnTuned TOA and SFC as needed                    

      TYPE PRF2_TYPE
        SEQUENCE
        INTEGER*2 d(2:2)   !! DOWNWELLING 
        INTEGER*2 u(nl2)   !! UPWELLNG
      END TYPE PRF2_TYPE

      TYPE SFC_TYPE
       SEQUENCE
       INTEGER*2 direct
       INTEGER*2 diffuse
      END TYPE SFC_TYPE

! Tuned

      TYPE FLX_TYPE
       SEQUENCE
       TYPE(PRF_TYPE) sw !SHORTWAVE
       TYPE(PRF_TYPE) lw !Longwave
       TYPE(SFC_TYPE) sfc ! SFC other
      END TYPE FLX_TYPE

! Untuned

      TYPE FLX2_TYPE
       SEQUENCE
       TYPE(PRF2_TYPE) sw !SHORTWAVE
       TYPE(PRF2_TYPE) lw !Longwave
      END TYPE FLX2_TYPE


      TYPE TUNE_VARIABLES_TYPE
       SEQUENCE
       REAL pw
       REAL uth
       REAL sfcalb
       REAL aot
       REAL skint
       REAL cldfrac(9)
       REAL cldtemp(9)
       REAL cldtau(9)
       INTEGER*2 Iwp(9)
       INTEGER*2 Lwp(9)  !HG-2025-0731
      END TYPE TUNE_VARIABLES_TYPE

! Spectral Fluxes

      TYPE SF_SW_TYPE
       SEQUENCE
       INTEGER*2 d(nswb)
       INTEGER*2 u(nswb)
      END TYPE SF_SW_TYPE

      TYPE SF_LW_SFC_TYPE
       SEQUENCE
       INTEGER*2 d(nlwb)
       INTEGER*2 u(nlwb)
      END TYPE SF_LW_SFC_TYPE

      TYPE SF_LW_TOA_TYPE
       SEQUENCE
!       INTEGER*2 d(nlwb)
       INTEGER*2 u(nlwb)
      END TYPE SF_LW_TOA_TYPE

      TYPE SF_TOA_TYPE
       SEQUENCE
       TYPE (SF_SW_TYPE) sw
       TYPE (SF_LW_TOA_TYPE) lw
      END TYPE SF_TOA_TYPE


      TYPE SF_SFC_TYPE
       SEQUENCE
       TYPE (SF_SW_TYPE) sw
       TYPE (SF_LW_SFC_TYPE) lw
      END TYPE SF_SFC_TYPE

      TYPE SF_LOC_TYPE
       SEQUENCE
       TYPE (SF_TOA_TYPE) toa
       TYPE (SF_SFC_TYPE) sfc
      END TYPE SF_LOC_TYPE


      TYPE SF_CND_TYPE
      SEQUENCE
      TYPE (SF_LOC_TYPE) tot
      END TYPE SF_CND_TYPE


      TYPE AS_TYPE 
       SEQUENCE
       INTEGER*2  toa_uva
       INTEGER*2  toa_uvb
       INTEGER*2  toa_par
       INTEGER*2 sfc_tot_uva
       INTEGER*2 sfc_tot_uvb
       INTEGER*2 sfc_tot_uvi
       INTEGER*2 sfc_tot_par_dir
       INTEGER*2 sfc_tot_par_dif
       INTEGER*2 sfc_clr_par_dir
       INTEGER*2 sfc_clr_par_dif
       INTEGER*2 sfc_prs_par_dir
       INTEGER*2 sfc_prs_par_dif
      END TYPE AS_TYPE


      TYPE ENT_TYPE 
       SEQUENCE
       REAL*4  toa_lwe_out
       REAL*4  atm_lwe_out
       REAL*4  sfc_lwe_out
       REAL*4  sfc_lwe_up
       REAL*4  sfc_lwe_dn
       REAL*4  atm_lwe_gen
       REAL*4  sfc_lwe_gen 
       REAL*4  toa_swe_inc
       REAL*4  atm_swe_inc
       REAL*4  sfc_swe_inc
       REAL*4  atm_swe_gen
       REAL*4  sfc_swe_gen
      END TYPE ENT_TYPE


      TYPE EMM_WNOLR
       SEQUENCE
       INTEGER*2 tot
       INTEGER*2 clr
      END TYPE EMM_WNOLR


      TYPE TU_TYPE
       SEQUENCE
        TYPE (FLX_TYPE) clr
        TYPE (FLX_TYPE) tot
        TYPE (FLX_TYPE) prs  
        TYPE (FLX_TYPE) tna 
        TYPE (EMM_WNOLR) wnolr !20140213
        TYPE (TUNE_VARIABLES_TYPE) var  
        TYPE (AS_TYPE) as
        TYPE (SF_CND_TYPE) spec
        TYPE (ENT_TYPE) ent
      END TYPE TU_TYPE

      TYPE UT_TYPE
       SEQUENCE
        TYPE (FLX2_TYPE) clr  ! 2layer
        TYPE (FLX2_TYPE) tot  ! 2layer
        TYPE (FLX2_TYPE) prs  ! 2layer
        TYPE (FLX2_TYPE) tna  ! 2layer
        TYPE (EMM_WNOLR) wnolr    !20140213 
        TYPE (TUNE_VARIABLES_TYPE) var
      END TYPE UT_TYPE


      TYPE SYNI4_MISC_TYPE
       SEQUENCE
       INTEGER*2 hr_month !1-744
       INTEGER*4 regnum !SSF
       INTEGER*2 toaswinsolation 
       INTEGER*2 sfcalbedo_source ! 0 Igbp Default, 1 Ocean ,2 Clrland, 3 Cloudy land, 4 Clr Snow, 5 Cld Snow, 6 Clear Ice, 7 Cld Ice, 8 IGBP snow
       INTEGER*2 error(2)  !! See check_for_bad_data , 1's CERES Flux,  100's Clouds  , +1000 Untuned profile  , +2000 Untuned Model , +3000 Tuned profile, +4000 , Tuned model
       INTEGER*2 sfc_pres
       INTEGER*2 sfc_hgt
       INTEGER*2 sfc_lev
       INTEGER*2 ut_aot_840
       INTEGER*2 o3_du
      END TYPE SYNI4_MISC_TYPE


      TYPE SYNI4_TYPE 
       SEQUENCE
        TYPE (UT_TYPE ) ut
        TYPE (TU_TYPE ) tu
        TYPE (SYNI4_MISC_TYPE) misc
      END TYPE SYNI4_TYPE 


      TYPE ( SYNI4_TYPE ) SYNI4

!HG-20260908
!      TYPE (SYNI4_4_TYPE) SYNI4_OUT

   !===========================================================
   ! Add the 4-cloud types here
   !===========================================================

   TYPE TUNE_VARIABLES_4_TYPE
      SEQUENCE
      REAL pw
      REAL uth
      REAL sfcalb
      REAL aot
      REAL skint
      REAL cldfrac(4)
      REAL cldtemp(4)
      REAL cldtau(4)
      INTEGER*2 Iwp(4)
      INTEGER*2 Lwp(4)
   END TYPE TUNE_VARIABLES_4_TYPE


   TYPE TU_4_TYPE
      SEQUENCE
      TYPE (FLX_TYPE) clr
      TYPE (FLX_TYPE) tot
      TYPE (FLX_TYPE) prs
      TYPE (FLX_TYPE) tna
      TYPE (EMM_WNOLR) wnolr
      TYPE (TUNE_VARIABLES_4_TYPE) var
      TYPE (AS_TYPE) as
      TYPE (SF_CND_TYPE) spec
      TYPE (ENT_TYPE) ent
   END TYPE TU_4_TYPE


   TYPE UT_4_TYPE
      SEQUENCE
      TYPE (FLX2_TYPE) clr
      TYPE (FLX2_TYPE) tot
      TYPE (FLX2_TYPE) prs
      TYPE (FLX2_TYPE) tna
      TYPE (EMM_WNOLR) wnolr
      TYPE (TUNE_VARIABLES_4_TYPE) var
   END TYPE UT_4_TYPE


   TYPE SYNI4_4_TYPE
      SEQUENCE
      TYPE (UT_4_TYPE) ut
      TYPE (TU_4_TYPE) tu
      TYPE (SYNI4_MISC_TYPE) misc
   END TYPE SYNI4_4_TYPE


   TYPE (SYNI4_4_TYPE) SYNI4_OUT
!-------------HG-20260909




! Fuliou SW and LW bands 

      INTEGER :: swb(nswb+1),lwb(nlwb+1)
 
! Fuliou SW bands [ ~11wm2 solar > 2500cm in 5350:4000]

      DATA swb(1:nswb+1) / 57000, 22857,14500,9060,2500/

! Fuliou LW bands

      DATA lwb(1:nlwb+1) / 2850, 1250,800,540,280,0/


      TYPE SYNI4_HEAD_TYPE
        SEQUENCE
        INTEGER ::spec_sw_bounds(nswb+1)
        INTEGER ::spec_lw_bounds(nlwb+1)
      END TYPE SYNI4_HEAD_TYPE

      TYPE (SYNI4_HEAD_TYPE) SYNI4_HEAD

      INTEGER SYNI4_unit
 
 CONTAINS



!HG-20260909

   SUBROUTINE COPY_SYNI4_TO_4(SYNI4, SYNI4_OUT)

      IMPLICIT NONE

      TYPE (SYNI4_TYPE)   SYNI4
      TYPE (SYNI4_4_TYPE) SYNI4_OUT

      !--------------------------------------------------------
      ! UT
      !--------------------------------------------------------

      SYNI4_OUT%ut%clr   = SYNI4%ut%clr
      SYNI4_OUT%ut%tot   = SYNI4%ut%tot
      SYNI4_OUT%ut%prs   = SYNI4%ut%prs
      SYNI4_OUT%ut%tna   = SYNI4%ut%tna
      SYNI4_OUT%ut%wnolr = SYNI4%ut%wnolr

      SYNI4_OUT%ut%var%pw     = SYNI4%ut%var%pw
      SYNI4_OUT%ut%var%uth    = SYNI4%ut%var%uth
      SYNI4_OUT%ut%var%sfcalb = SYNI4%ut%var%sfcalb
      SYNI4_OUT%ut%var%aot    = SYNI4%ut%var%aot
      SYNI4_OUT%ut%var%skint  = SYNI4%ut%var%skint

      SYNI4_OUT%ut%var%cldfrac = SYNI4%ut%var%cldfrac(1:4)
      SYNI4_OUT%ut%var%cldtemp = SYNI4%ut%var%cldtemp(1:4)
      SYNI4_OUT%ut%var%cldtau  = SYNI4%ut%var%cldtau(1:4)
      SYNI4_OUT%ut%var%Iwp     = SYNI4%ut%var%Iwp(1:4)
      SYNI4_OUT%ut%var%Lwp     = SYNI4%ut%var%Lwp(1:4)


      !--------------------------------------------------------
      ! TU
      !--------------------------------------------------------

      SYNI4_OUT%tu%clr   = SYNI4%tu%clr
      SYNI4_OUT%tu%tot   = SYNI4%tu%tot
      SYNI4_OUT%tu%prs   = SYNI4%tu%prs
      SYNI4_OUT%tu%tna   = SYNI4%tu%tna
      SYNI4_OUT%tu%wnolr = SYNI4%tu%wnolr

      SYNI4_OUT%tu%as   = SYNI4%tu%as
      SYNI4_OUT%tu%spec = SYNI4%tu%spec
      SYNI4_OUT%tu%ent  = SYNI4%tu%ent

      SYNI4_OUT%tu%var%pw     = SYNI4%tu%var%pw
      SYNI4_OUT%tu%var%uth    = SYNI4%tu%var%uth
      SYNI4_OUT%tu%var%sfcalb = SYNI4%tu%var%sfcalb
      SYNI4_OUT%tu%var%aot    = SYNI4%tu%var%aot
      SYNI4_OUT%tu%var%skint  = SYNI4%tu%var%skint

      SYNI4_OUT%tu%var%cldfrac = SYNI4%tu%var%cldfrac(1:4)
      SYNI4_OUT%tu%var%cldtemp = SYNI4%tu%var%cldtemp(1:4)
      SYNI4_OUT%tu%var%cldtau  = SYNI4%tu%var%cldtau(1:4)
      SYNI4_OUT%tu%var%Iwp     = SYNI4%tu%var%Iwp(1:4)
      SYNI4_OUT%tu%var%Lwp     = SYNI4%tu%var%Lwp(1:4)


      !--------------------------------------------------------
      ! Miscellaneous
      !--------------------------------------------------------

      SYNI4_OUT%misc = SYNI4%misc

   END SUBROUTINE COPY_SYNI4_TO_4
!HG-20260909




!
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
!
      INTEGER*2 function pfp(rflux)
!
!*****************************************************************************
!
! !F90
!
! !Name:
!   pfp
!
! !Description:
!    Purpose - Packs flux data
!
! 
! !Input PARAMETERs:
!    rflux - radiative flux data
!
! !Output PARAMETERs:
!    pfp - packed flux data
!
! !Team-Unique Header:
!
!  Modules Used: (parameters followed by "*" are defined by this routine)
!
!  Input Files:
!    NONE
!
!  Notes: 
!
! !Revision History:
!  Version 1.0   October 1, 2013 - SCCR #1017
!                 Fred Rose, SSAI, Fred.G.Rose@nasa.gov
!                 Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!                 Initial Version of Module
!
! !END
!
!*****************************************************************************
!

      REAL*4 rflux
      INTEGER ipack

      ipack = nint(rflux*40.0) - 32767
      pfp   = ipack

      IF ( rflux < 0 .OR. rflux > 1500) pfp =  INT2_DFLT

      END FUNCTION pfp
!
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
!
      REAL function ufp(i2flux)
!
!*****************************************************************************
!
! !F90
!
! !Name:
!   ufp
!
! !Description:
!    Purpose - Unpacks flux data
!
! 
! !Input PARAMETERs:
!    i2flux - radiative flux data
!
! !Output PARAMETERs:
!    ufp - unpacked flux data
!
! !Team-Unique Header:
!
!  Modules Used: (parameters followed by "*" are defined by this routine)
!
!  Input Files:
!    NONE
!
!  Notes: 
!
! !Revision History:
!  Version 1.0   October 1, 2013 - SCCR #1017
!                 Fred Rose, SSAI, Fred.G.Rose@nasa.gov
!                 Thomas Caldwell, SSAI, Thomas.E.Caldwell@nasa.gov
!                 Initial Version of Module
!
! !END
!
!*****************************************************************************
!


      INTEGER*2 i2flux
      
      ufp = ((i2flux+32767)/40.)
      IF (  i2flux == INT2_DFLT ) ufp = REAL4_DFLT
      
      END FUNCTION ufp
!
