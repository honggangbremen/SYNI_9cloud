MODULE JIN_LUTS_INTERFACE
 integer,parameter::nfu =18	 
 integer, parameter:: mxn =24 ,nvoc=5 , nvsn = 5 , nvic =5
 integer,parameter ::nrec_oc = 201600, nrec_sn=82368, nrec_ic=11616
 real ocean_table
 real snow_table
 real ice_table 
 
 common /jin_ocean_dat/ ocean_table(nrec_oc)
 common /jin_snow_dat/ snow_table(nrec_sn)
 common /jin_ice_dat/ ice_table(nrec_ic)       
       
 logical ,save::ichoose_oc(nvoc,2**nvoc),&
 		ichoose_sn(nvsn,2**nvsn),&
		ichoose_ic(nvic,2**nvic)

 integer,save:: nva_oc(nvoc), nva_sn(nvsn), nva_ic(nvic)
 
 real,save:: anodes_oc(mxn,nvoc), anodes_sn(mxn,nvsn), anodes_ic(mxn,nvic)

 logical,save :: lzjlut = .false.
 
real,save::  flcen(nfu)
 data flcen/ &
 50750.,42750. ,38000.,34250.,32254. ,&
 29490.,25414.5,21479.,18454.,15653.5, &
 13550.,11925. ,10425., 8650.,& 
  6475., 4625. , 3425., 2675./




 TYPE JINALB 
 sequence
 real u0
 real tau 
 real wind   !OCEAN ONLY
 real chlor  !OCEAN ONLY
! real angex  !OCEAN ONLY 
  real soot       !SNOW ONLY
  real snowradius !SNOW ONLY
 real tice    !ICE ONLY
 real aice    !ICE ONLY
 real specalb(nfu)
 character*5 mode
END  TYPE 

type (JINALB) jlut
	
 

 CONTAINS
!===============================================================
subroutine jin_all_luts
	if( .not. lzjlut ) call zjlut_init
if ( jlut%mode == 'water') call get_zjin_water
if ( jlut%mode == 'ice'  ) call get_zjin_ice
if ( jlut%mode == 'snow' ) call get_zjin_snow
end subroutine jin_all_luts
!==============================================================
	subroutine get_zjin_water!!(u0,tau,wind,chlor,angex, specalb)
	real val(nvoc)

	val(2)=  jlut%chlor     ! Chlorophyll
	val(3)=  jlut%wind    	! Wind
	val(4)=  jlut%u0    ! CosSol
	val(5)=  jlut%tau    ! Tau 
!	val(6)=  jlut%angex      ! ANGSTROM EXPONET
       
       do ix = 1,nfu 
        val(1)=ix
        jlut%specalb(ix) = &
	zjlut(nvoc,val,ichoose_oc,anodes_oc,nva_oc,nrec_oc,ocean_table)
      enddo
       end subroutine get_zjin_water
!!==============================================================
	subroutine get_zjin_snow!(,soot,snowradius,u0,tau)
	real val(nvsn)

	val(2)= jlut%soot
	val(3)= jlut%snowradius
	val(4)= jlut%u0	! COSSZA 
	val(5)= jlut%tau  	! TAU !CLEAR SKY

	SPECTRAL : do ix = 1,nfu 
	 val(1)= ix
	  jlut%specalb(ix) = &
	 zjlut(nvsn,val,ichoose_sn,anodes_sn,nva_sn,nrec_sn,snow_table)
	enddo SPECTRAL
	end subroutine get_zjin_snow
!!==============================================================
	subroutine get_zjin_ice! (u0,tau,tice,aice)
	real val(nvic)
     
       val(2) =jlut%u0
       val(3) =jlut%tau
       val(4) =jlut%tice
       val(5) =jlut%aice
       SPECTRAL : do ix = 1,nfu  
       val(1) = ix
          jlut%specalb(ix)= &
	zjlut(nvic,val,ichoose_ic,anodes_ic,nva_ic,nrec_ic,ice_table)
       enddo SPECTRAL

	end subroutine get_zjin_ice
!----------------------------------------------------------------------------
!----------------------------------------------------------------------------
	subroutine zjlut_init

! nv = # of Variables in look up table.
! mxn = Max # of nodes for any single variable
! nva = # of nodes for each variables
! anodes = The values at each node in the table; for all variables
! table = the look-up table values.
!OCEAN Table-----------------------------------------------------------------------------		     

		nva_oc =(/24,5,7,15,16/)

!!Angstrom Exponet
!!	anodes_oc(1:2,6) = (/0.5,2.0/)

! TAU
	anodes_oc(1:16,5) =(/0.0, 0.05, 0.1, 0.16, 0.24, 0.35, 0.5, 0.7, 0.99, &
                  1.3, 1.8, 2.5, 5.0, 9.0, 15.0, 25.0 /)
!COSSOL
	anodes_oc(1:15,4) =(/0.05, 0.09, 0.15, 0.21, 0.27, 0.33, 0.39, 0.45, &
                  0.52, 0.60, 0.68, 0.76, 0.84, 0.92, 1.0 /)
!WIND
	anodes_oc(1:7,3)=(/0., 3., 6., 9., 12., 15., 18. /)

!CHLOROPHYLL
	anodes_oc(1:5,2)=(/0.0, 0.1,0.5,2.0,12.0/)
!BAND

        anodes_oc(1:24,1)=(/36670.,31820., 29040.,26390.,23860.,21780., &
			    20040.,18390., 16580.,15060.,13900.,13060., &
			    12180.,10770.,  9560., 8760., 8120., 7180., &
			     6300., 5390.,  4450., 3820., 3180., 2710. /) 
			     
	anodes_oc(1:24,1)= 10000./anodes_oc(1:24,1)! Cm-1 to microns

!Snow Table-----------------------------------------------------------------------------		     

	nva_sn = (/24,4,6,13,11/)

!1- 24 Zjin BANDs
	anodes_sn(1:24,1)= &
      (/2710.,  3180.,  3820.,  4450.,  5390., 6300.  &
       ,7180.,  8120.,  8760.,  9560., 10770., 12180. &
       ,13060., 13900., 15060., 16580., 18390., 20040.&
     	,21780., 23860., 26390., 29040., 31820., 36670./)


!2-4 SOOT FRACTION  in volume (in unit permillion)
	anodes_sn(1:4,2)=(/0.0, 0.1, 1.0, 10.0/)

!3-6 Effective Snow Radius (um) 
	anodes_sn(1:6,3)=(/50., 100., 200., 500., 1000., 2000./)

!4-13 COSSZA 
	anodes_sn(1:13,4)= &
      (/0.05, 0.09, 0.15, 0.21, 0.27, 0.33, 0.39, 0.45, &
        0.52, 0.60, 0.68, 0.76, 0.86 /)

!5-11TAU
       anodes_sn(1:11,5) =(/0.0, 0.05, 0.12, 0.24, 0.5, 0.99, &
       1.3, 2.0, 4.0, 9.0, 20.0 /)

!ICE Table-----------------------------------------------------------------------------		     
	nva_ic = (/24,11,11,2,2/)


!1- 24 Zjin BANDs
	anodes_ic(1:24,1)= &
      (/2710.,  3180.,  3820.,  4450.,  5390., 6300.  &
       ,7180.,  8120.,  8760.,  9560., 10770., 12180. &
       ,13060., 13900., 15060., 16580., 18390., 20040.&
     	,21780., 23860., 26390., 29040., 31820., 36670./)

!2-11 COSSZA 
	anodes_ic(1:11,2)= &
      (/0.05, 0.09, 0.15, 0.21, 0.27, 0.33, 0.39, 0.45, &
        0.52, 0.60, 0.68 /)

!3-11TAU
       anodes_ic(1:11,3) =(/0.0, 0.05, 0.12, 0.24, 0.5, 0.99, &
       1.3, 2.0, 4.0, 9.0, 20.0 /)

!4-2 Temperatures (K)
	anodes_ic(1:2,4)=(/258.15,271.15/)

!5-2 Age (new[0], old[1]) 
	anodes_ic(1:2,5)=(/0,1/)       
       
!----------------------------------------------------------------------------------

	call tf_table(nvoc,2**nvoc,ichoose_oc)
	call tf_table(nvsn,2**nvsn,ichoose_sn)
	call tf_table(nvic,2**nvic,ichoose_ic)	

!	 nrec_oc = 1 ; nrec_sn = 1 ; nrec_ic = 1 
!	 do iv=1,nvoc ; nrec_oc = nrec_oc * nva_oc(iv) ;enddo
!	 do iv=1,nvsn ; nrec_sn = nrec_sn * nva_sn(iv) ;enddo
!	 do iv=1,nvic ; nrec_ic = nrec_ic * nva_ic(iv) ;enddo
	 
!	allocate (ocean_table(nrec_oc))   
!	allocate ( snow_table(nrec_sn)) 
!	allocate (  ice_table(nrec_ic)) 


	lzjlut = .true.

!	print*, 'LUTs initalized : #records=',nrec_oc,nrec_sn,nrec_ic

	end subroutine zjlut_init
	
!=======================================================================	
!----------------------------------------------------------------
	real function zjlut(nv,val,ichoose,anodes,nva,nrec,table)
	implicit none
	integer nv
	real val(nv)
	
	logical ichoose(nv,2**nv)
	real anodes(mxn,nv)
	integer nva(nv),nrec
	real table(nrec)
	
!-----	
	real value_table, swx,wx,rmin,rmax,trlui
	integer i,j,ik,k,iv,in
	integer  iva(nv,2**nv)
	
	real wb(nv),wt(nv),rva(nv)
	integer ibase(nv),itop(nv)
	
	val(1) =  flcen(ifix(val(1))) !!! Fu-Liou Band to cm-1 for lookup
	if ( jlut%mode == 'water')val(1) = 10000./val(1)
!	print*,val(1)
!--------------------
	 VSET : do iv=1,nv 
	rmin = anodes(1,iv)
	rmax = anodes(nva(iv),iv)

	if (val(iv) <= rmin )then 
	  rva(iv) = 1
	elseif (val(iv) >= rmax ) then
	  rva(iv) = nva(iv)
	else

	FNODES : do in = 1,nva(iv)-1
	if( val(iv) >= anodes(in,iv) .and. val(iv) < anodes(in+1,iv) ) &
        rva(iv)= in+( val(iv)-anodes(in,iv)) /			      &
      		    (anodes(in+1,iv)-anodes(in,iv))
	enddo FNODES

	endif

!	print*,iv,rva(iv)
	enddo VSET
!---------------------

	 ibase = floor(rva)
	 where( ibase < 1) ibase=1

	 itop= ceiling(rva)
	 where( itop > nva) itop=nva

	wb=1.0-(rva-ibase)
	wt=1.0-wb
	
!	print'(A10,10f5.1)','Exact',rva(1:nv)
!	print'(A10,10I5)','BASE',ibase
!	print'(A10,10I5)','TOP',itop
!	print'(A10,10f5.1)','Wb',wb	
!	print'(A10,10f5.1)','Wt',wt

	swx=0 ; trlui =0 ; ik=0

	NODE : do j=1,2**nv
	wx=1.0

	 DIMENSION: do i=1,nv

	 if( ichoose(i,j) ) then
	  iva(i,j) = itop(i)
	  wx=wx*wt(i)
	 else
	  iva(i,j) = ibase(i)
	  wx=wx*wb(i)
	 endif

	 enddo DIMENSION

	 if( wx > 0 ) then
	 ik=ik+1
	 k = ilui(nv,nva,iva(1,j))

	 value_table = table(k)

	 swx       = swx  +               wx
	 trlui      = trlui + value_table * wx

!	print'(2I4,i10,4f10.5,10I4)',ik,j,k,value_table ,wx,swx,trlui,iva(1:nv,j)
!	if (swx >= 0.9999 )exit
	endif

	enddo NODE
        zjlut = trlui/swx

        !print *, zjlut
	return
	end function zjlut
	
!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!------------------------------------------------------------------------
	subroutine tf_table(n1,n2,ib)
	implicit none
	integer n1,n2,i,ii
	logical ib(n1,n2)

	do i=1,n2
	do ii=1,n1
	ib(ii,i)=btest(i-1,ii-1)
	enddo
!	print*,i,ib(1:n1,i)
	enddo

	return
	end subroutine tf_table
	
!-----------------------------------------------------------------------
	integer function ilui(nv,nva,iva)
	implicit none
	integer nv ,iva(nv), nva(nv)
	integer i,k
	integer  mva(nv)

	mva(1)=nva(1)
	do i=2,nv
	 mva(i)=mva(i-1)*nva(i)
	enddo

	k= iva(1)
	do i=2,nv
	k= k+ (iva(i)-1)*mva(i-1)
	enddo

	ilui=k
	return
	end function ilui
!-----------------------------------------------------------------------
	END MODULE JIN_LUTS_INTERFACE
	
!

